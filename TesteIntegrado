  function populateBoletimFilters(){
    wireComboBox('bmCliente', 'bmClienteList', function(){ return CLIENTES.slice().sort(function(a,b){return a.localeCompare(b,'pt-BR');}); }, null, null, 'Todos os clientes');
    var curC = document.getElementById('bmCliente').value.trim();
    var ordensDisponiveis = state.ordens.filter(function(o){ return !curC || o.cliente===curC; })
      .sort(function(a,b){ var c=a.cliente.localeCompare(b.cliente,'pt-BR'); return c!==0?c:a.nome.localeCompare(b.nome,'pt-BR'); });
    wireComboBox('bmOrdem', 'bmOrdemList', function(){ return ordensDisponiveis.map(function(o){ return ordemLabel(o); }); }, ordensDisponiveis.map(function(o){ return o.cliente; }), null, 'Todas as ordens');
    if(!document.getElementById('bmDe').value && !document.getElementById('bmAte').value){
      var d = new Date();
      document.getElementById('bmDe').value = d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-01';
      var ultimoDia = new Date(d.getFullYear(), d.getMonth()+1, 0).getDate();
      document.getElementById('bmAte').value = d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(ultimoDia).padStart(2,'0');
    }
  }

  function calcularBoletim(ordemId, de, ate){
    var todasDaOrdem = state.apropriacoes.filter(function(a){ return a.ordemId===ordemId; });
    var anteriores = todasDaOrdem.filter(function(a){ return a.data < de; });
    var atuais = todasDaOrdem.filter(function(a){ return a.data >= de && a.data <= ate; });

    // Produção por tonelada agora vem do módulo de Produção (lançamento diário por material),
    // não mais do campo antigo "Produção (toneladas)" da Apropriação (eliminado).
    var producoesDaOrdem = state.producoes.filter(function(p){ return p.ordemId===ordemId && p.tipo==='pesagem'; });
    var producoesAnteriores = producoesDaOrdem.filter(function(p){ return p.data < de; });
    var producoesAtuais = producoesDaOrdem.filter(function(p){ return p.data >= de && p.data <= ate; });

    var linhas = [];

    // Um serviço pode ter várias versões de tarifa ao longo do tempo (reajustes de preço); aqui
    // agrupamos por serviço e aplicamos, para cada lançamento de produção, o valor que estava
    // vigente NA DATA daquele lançamento — assim um reajuste feito hoje não altera medições passadas.
    var servicosUnicos = Array.from(new Set(tarifasDaOrdem(ordemId).map(function(t){ return t.servico; })));
    servicosUnicos.forEach(function(servico){
      var qtdAnterior = 0, valorAnterior = 0, qtdAtual = 0, valorAtual = 0;
      producoesAnteriores.filter(function(p){ return p.material===servico; }).forEach(function(p){
        var tar = tarifaVigenteNaData(ordemId, servico, p.data);
        if(tar){ qtdAnterior += (p.valor||0); valorAnterior += (p.valor||0)*tar.valor; }
      });
      producoesAtuais.filter(function(p){ return p.material===servico; }).forEach(function(p){
        var tar = tarifaVigenteNaData(ordemId, servico, p.data);
        if(tar){ qtdAtual += (p.valor||0); valorAtual += (p.valor||0)*tar.valor; }
      });
      var tarRef = tarifaVigenteNaData(ordemId, servico, ate) || tarifasDaOrdem(ordemId).filter(function(t){ return t.servico===servico; }).sort(function(a,b){ return (b.vigenciaInicio||'').localeCompare(a.vigenciaInicio||''); })[0];
      linhas.push({
        servico:servico, unidade: tarRef?tarRef.unidade:'TON', valorUnit: tarRef?tarRef.valor:0,
        qtdAnterior:qtdAnterior, qtdAtual:qtdAtual, qtdAcumulado:qtdAnterior+qtdAtual,
        valorAnterior:valorAnterior, valorAtual:valorAtual, valorAcumulado:valorAnterior+valorAtual
      });
    });

    state.tarifasHora.filter(function(t){ return t.ordemId===ordemId; }).forEach(function(t){
      var lancAnt = anteriores;
      var lancAtu = atuais;
      var horasAnterior = horasFaturadasPorMes(lancAnt, t);
      var horasAtual = horasFaturadasPorMes(lancAtu, t);
      linhas.push({
        servico:t.servico, unidade:'HORA', valorUnit:t.valorHora,
        qtdAnterior:horasAnterior, qtdAtual:horasAtual, qtdAcumulado:horasAnterior+horasAtual,
        valorAnterior:horasAnterior*t.valorHora, valorAtual:horasAtual*t.valorHora, valorAcumulado:(horasAnterior+horasAtual)*t.valorHora
      });
    });

    // Verba (evento) — igual à produção por tonelada, mas o "material" lançado é a contagem de eventos
    // (mobilização, desmobilização etc.), vinda também do módulo de Produção.
    var producoesVerbaDaOrdem = state.producoes.filter(function(p){ return p.ordemId===ordemId && p.tipo==='verba'; });
    var producoesVerbaAnteriores = producoesVerbaDaOrdem.filter(function(p){ return p.data < de; });
    var producoesVerbaAtuais = producoesVerbaDaOrdem.filter(function(p){ return p.data >= de && p.data <= ate; });
    var servicosVerbaUnicos = Array.from(new Set(tarifasVerbaDaOrdem(ordemId).map(function(t){ return t.servico; })));
    servicosVerbaUnicos.forEach(function(servico){
      var qtdAnterior = 0, valorAnterior = 0, qtdAtual = 0, valorAtual = 0;
      producoesVerbaAnteriores.filter(function(p){ return p.material===servico; }).forEach(function(p){
        var tar = tarifaVerbaVigenteNaData(ordemId, servico, p.data);
        if(tar){ qtdAnterior += (p.valor||0); valorAnterior += (p.valor||0)*tar.valor; }
      });
      producoesVerbaAtuais.filter(function(p){ return p.material===servico; }).forEach(function(p){
        var tar = tarifaVerbaVigenteNaData(ordemId, servico, p.data);
        if(tar){ qtdAtual += (p.valor||0); valorAtual += (p.valor||0)*tar.valor; }
      });
      var tarRef = tarifaVerbaVigenteNaData(ordemId, servico, ate) || tarifasVerbaDaOrdem(ordemId).sort(function(a,b){ return (b.vigenciaInicio||'').localeCompare(a.vigenciaInicio||''); })[0];
      linhas.push({
        servico:servico, unidade:'VB', valorUnit: tarRef?tarRef.valor:0,
        qtdAnterior:qtdAnterior, qtdAtual:qtdAtual, qtdAcumulado:qtdAnterior+qtdAtual,
        valorAnterior:valorAnterior, valorAtual:valorAtual, valorAcumulado:valorAnterior+valorAtual
      });
    });

    return linhas;
  }

  function renderBoletimMedicao(){
    populateBoletimFilters();
    var ordemId = resolverOrdemFiltro('bmOrdem');
    var de = document.getElementById('bmDe').value;
    var ate = document.getElementById('bmAte').value;
    var el = document.getElementById('bmConteudo');
    if(!ordemId){
      el.innerHTML = '<div class="empty-state" style="padding:24px;">Selecione uma Ordem para gerar o Boletim de Medição.</div>';
      return;
    }
    var ord = getOrdem(ordemId);
    var linhas = calcularBoletim(ordemId, de, ate);
    var totalMedicao = linhas.reduce(function(s,l){ return s+l.valorAtual; },0);

    var tabelaHtml = linhas.length===0
      ? '<div class="empty-state" style="padding:20px;">Nenhuma tarifa cadastrada para esta ordem, ou nenhum serviço executado no período.</div>'
      : '<div class="table-wrap"><table><thead><tr><th>Serviço</th><th>Unid.</th><th class="num">R$ Unit.</th>' +
        '<th class="num">Qtd. Anterior</th><th class="num">Qtd. Atual</th><th class="num">Qtd. Acumulado</th>' +
        '<th class="num">Valor Anterior</th><th class="num">Valor Atual</th><th class="num">Valor Acumulado</th></tr></thead><tbody>' +
        linhas.map(function(l){
          return '<tr><td>'+esc(l.servico)+'</td><td>'+esc(l.unidade)+'</td><td class="num">'+brNum(l.valorUnit,2)+'</td>' +
            '<td class="num">'+brNum(l.qtdAnterior,2)+'</td><td class="num">'+brNum(l.qtdAtual,2)+'</td><td class="num">'+brNum(l.qtdAcumulado,2)+'</td>' +
            '<td class="num">'+brNum(l.valorAnterior,2)+'</td><td class="num">'+brNum(l.valorAtual,2)+'</td><td class="num">'+brNum(l.valorAcumulado,2)+'</td></tr>';
        }).join('') +
        '</tbody></table></div>';

    el.innerHTML =
      '<div class="card" style="margin-bottom:16px;">' +
        '<h2>Natureza da Medição</h2>' +
        '<div style="font-size:12.5px;color:var(--text-muted);margin-bottom:10px;">'+esc(ord.cliente)+' · '+esc(ordemLabel(ord))+' · Período: '+brDate(de)+' a '+brDate(ate)+'</div>' +
        tabelaHtml +
      '</div>' +
      '<div class="card">' +
        '<h2>Descontos e total líquido</h2>' +
        '<div class="kpi-row" style="margin-bottom:14px;"><div class="kpi-card"><div class="kpi-label">A) Total da Medição (Atual)</div><div class="kpi-value">R$ '+brNum(totalMedicao,2)+'</div></div></div>' +
        '<div class="field-row">' +
          '<div class="field"><label>B) % Parcela mão de obra</label><input type="number" step="0.01" id="bmAliqMaoObra" value="35"></div>' +
          '<div class="field"><label>C) % Retenção INSS (sobre B)</label><input type="number" step="0.01" id="bmAliqInss" value="11"></div>' +
          '<div class="field"><label>D) % Retenção ISS (sobre A)</label><input type="number" step="0.01" id="bmAliqIss" value="5"></div>' +
          '<div class="field"><label>E) Outras retenções (R$)</label><input type="number" step="0.01" id="bmOutrasRetencoes" value="0"></div>' +
        '</div>' +
        '<div id="bmDescontosResultado" style="margin-top:10px;"></div>' +
      '</div>';

    function recalcularDescontos(){
      var maoObraPct = parseFloat(document.getElementById('bmAliqMaoObra').value)||0;
      var inssPct = parseFloat(document.getElementById('bmAliqInss').value)||0;
      var issPct = parseFloat(document.getElementById('bmAliqIss').value)||0;
      var outras = parseFloat(document.getElementById('bmOutrasRetencoes').value)||0;
      var baseMaoObra = totalMedicao * (maoObraPct/100);
      var valorInss = baseMaoObra * (inssPct/100);
      var valorIss = totalMedicao * (issPct/100);
      var totalDesconto = valorInss + valorIss + outras;
      var totalLiquido = totalMedicao - totalDesconto;
      document.getElementById('bmDescontosResultado').innerHTML =
        '<table style="width:100%;font-size:13px;"><tbody>' +
        '<tr><td>B) Parcela relativa à mão de obra ('+maoObraPct+'% de A)</td><td class="num">R$ '+brNum(baseMaoObra,2)+'</td></tr>' +
        '<tr><td>C) Retenção ref. INSS ('+inssPct+'% de B)</td><td class="num">R$ '+brNum(valorInss,2)+'</td></tr>' +
        '<tr><td>D) Retenção ref. ISS ('+issPct+'% de A)</td><td class="num">R$ '+brNum(valorIss,2)+'</td></tr>' +
        '<tr><td>E) Outras Retenções</td><td class="num">R$ '+brNum(outras,2)+'</td></tr>' +
        '<tr style="font-weight:700;border-top:1px solid var(--border);"><td>F) TOTAL DE DESCONTO</td><td class="num">R$ '+brNum(totalDesconto,2)+'</td></tr>' +
        '<tr style="font-weight:700;color:var(--navy);"><td>G) TOTAL LÍQUIDO A RECEBER</td><td class="num">R$ '+brNum(totalLiquido,2)+'</td></tr>' +
        '</tbody></table>';
      window.__bmUltimoCalculo = {linhas:linhas, totalMedicao:totalMedicao, baseMaoObra:baseMaoObra, valorInss:valorInss, valorIss:valorIss, outras:outras, totalDesconto:totalDesconto, totalLiquido:totalLiquido, maoObraPct:maoObraPct, inssPct:inssPct, issPct:issPct};
    }
    ['bmAliqMaoObra','bmAliqInss','bmAliqIss','bmOutrasRetencoes'].forEach(function(id){
      document.getElementById(id).addEventListener('input', recalcularDescontos);
    });
    recalcularDescontos();
  }

  /* ---- Custos (combustível, peças/manutenção, mão de obra, outro) ---- */
  function renderMedicao(){
    recalcularHorimetrosEfetivos();
    renderBoletimMedicao();
    populateMedFilters();
    renderTarifasHoraTabela();
    var lista = medicaoFiltrarLista();
    var linhas = medicaoPorTarifa(lista);
    var totalHoras = linhas.reduce(function(s,l){ return s+l.horasEfetivas; },0);
    var totalValor = linhas.reduce(function(s,l){ return s+l.valor; },0);
    var abaixoMinimo = linhas.filter(function(l){ return l.horasEfetivas < (l.tarifa.horasMinimasMes||0); }).length;
    function kpi(label, value){ return '<div class="kpi-card"><div class="kpi-label">'+esc(label)+'</div><div class="kpi-value">'+value+'</div></div>'; }
    document.getElementById('medKpiRow').innerHTML =
      kpi('Tarifas cadastradas', state.tarifasHora.length) +
      kpi('Horas efetivas (período)', brNum(totalHoras,1)) +
      kpi('Valor de medição (período)', 'R$ '+brNum(totalValor,2)) +
      kpi('Abaixo do mínimo mensal', abaixoMinimo);
    var body = document.getElementById('medicaoBody');
    if(linhas.length===0){ body.innerHTML='<tr class="empty-row"><td colspan="7">Nenhuma tarifa por hora cadastrada ainda.</td></tr>'; return; }
    body.innerHTML = linhas.map(function(l){
      var ord = getOrdem(l.tarifa.ordemId);
      var abaixoDoMinimo = l.horasEfetivas < (l.tarifa.horasMinimasMes||0);
      return '<tr><td>'+(ord?esc(ordemLabel(ord)):'—')+'</td><td>'+esc(l.tarifa.servico)+'</td>'+
        '<td class="num'+(abaixoDoMinimo?' diff-warn':'')+'">'+brNum(l.horasEfetivas,1)+'</td>'+
        '<td class="num">'+brNum(l.tarifa.horasMinimasMes,0)+'</td>'+
        '<td class="num">'+brNum(l.horasFaturadas,1)+(abaixoDoMinimo?' <span class="muted-tag" title="Faturado pelo mínimo contratual">†</span>':'')+'</td>'+
        '<td class="num">'+brNum(l.tarifa.valorHora,2)+'</td><td class="num">'+brNum(l.valor,2)+'</td></tr>';
    }).join('');
  }


  /* ---- Produção — lançamento diário por material/serviço, com meta mensal por ordem ---- */
  function diasNoMes(ano, mes){ return new Date(ano, mes, 0).getDate(); }

  function populateProdFilters(){
    var restrito = (state.perfil==='campo' && state.operadorOrdemId);
    if(restrito){
      var ordRestrita = getOrdem(state.operadorOrdemId);
      if(ordRestrita && !document.getElementById('prodOrdem').value){
        document.getElementById('prodCliente').value = ordRestrita.cliente;
        document.getElementById('prodOrdem').value = ordemDescricao(ordRestrita);
      }
      document.getElementById('prodCliente').setAttribute('readonly','readonly');
      document.getElementById('prodOrdem').setAttribute('readonly','readonly');
      document.getElementById('prodOrdemRestritoNota').innerHTML = '<div class="muted-tag" style="margin-top:4px;">Você está restrito a esta ordem.</div>';
    } else {
      document.getElementById('prodCliente').removeAttribute('readonly');
      document.getElementById('prodOrdem').removeAttribute('readonly');
      document.getElementById('prodOrdemRestritoNota').innerHTML = '';
    }
    var curC = document.getElementById('prodCliente').value.trim();
    wireComboBox('prodCliente', 'prodClienteList', function(){ return CLIENTES.slice().sort(function(a,b){return a.localeCompare(b,'pt-BR');}); }, null, null, 'Todos os clientes');
    var ordensDisponiveis = (restrito ? state.ordens.filter(function(o){ return o.id===state.operadorOrdemId; }) : state.ordens.filter(function(o){ return !curC || o.cliente===curC; }))
      .sort(function(a,b){ var c=a.cliente.localeCompare(b.cliente,'pt-BR'); return c!==0?c:a.nome.localeCompare(b.nome,'pt-BR'); });
    wireComboBox('prodOrdem', 'prodOrdemList', function(){ return ordensDisponiveis.map(function(o){ return ordemDescricao(o); }); }, ordensDisponiveis.map(function(o){ return o.cliente; }));
    if(!document.getElementById('prodMes').value){
      var d = new Date();
      document.getElementById('prodMes').value = d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0');
    }
  }

  async function salvarProducaoValor(ordemId, tipo, material, data, valor){
    var existente = state.producoes.filter(function(p){ return p.ordemId===ordemId && p.tipo===tipo && p.material===material && p.data===data; })[0];
    if(valor===0 || isNaN(valor)){
      if(existente){ state.producoes = state.producoes.filter(function(p){ return p!==existente; }); }
    } else if(existente){
      existente.valor = valor;
    } else {
      state.producoes.push({id:uid(), ordemId:ordemId, tipo:tipo, material:material, data:data, valor:valor});
    }
    await saveList('producoes_v1', state.producoes);
  }

  function renderProducao(){
    populateProdFilters();
    var ordemTexto = document.getElementById('prodOrdem').value.trim();
    var ordem = state.ordens.filter(function(o){ return ordemDescricao(o)===ordemTexto; })[0];
    var el = document.getElementById('prodConteudo');
    if(!ordem){
      el.innerHTML = '<div class="empty-state" style="padding:24px;">Selecione uma Ordem para lançar/ver a produção.</div>';
      return;
    }
    var materiaisPesagem = ordem.materiaisPesagem || [];
    var materiaisHora = ordem.materiaisHora || [];
    var materiaisVerba = ordem.materiaisVerba || [];
    if(materiaisPesagem.length===0 && materiaisHora.length===0 && materiaisVerba.length===0){
      el.innerHTML = '<div class="empty-state" style="padding:24px;">Esta ordem ainda não tem materiais de Pesagem, serviços por Hora nem por Verba configurados. Cadastre em Cadastros → Ordens → Editar → Caracterização da Medição.</div>';
      return;
    }
    var mesRef = document.getElementById('prodMes').value || (new Date().getFullYear()+'-'+String(new Date().getMonth()+1).padStart(2,'0'));
    var ano = parseInt(mesRef.split('-')[0],10), mes = parseInt(mesRef.split('-')[1],10);
    var totalDias = diasNoMes(ano, mes);

    var metaMensalTon = materiaisPesagem.reduce(function(s,m){ return s+(m.meta||0); },0);
    var metaMensalHora = materiaisHora.reduce(function(s,m){ return s+(m.meta||0); },0);
    var metaMensalVerba = materiaisVerba.reduce(function(s,m){ return s+(m.meta||0); },0);
    var metaDiariaTon = totalDias>0 ? metaMensalTon/totalDias : 0;

    function valorDoDia(tipo, material, dia){
      var dataISO = ano+'-'+String(mes).padStart(2,'0')+'-'+String(dia).padStart(2,'0');
      var reg = state.producoes.filter(function(p){ return p.ordemId===ordem.id && p.tipo===tipo && p.material===material && p.data===dataISO; })[0];
      return reg ? reg.valor : 0;
    }

    var totalPorDiaTon = [];
    var totalPorDiaVerba = [];
    var diasAtingiuMeta = 0;
    var producaoTotalTon = 0;
    var producaoTotalVerba = 0;
    for(var d=1; d<=totalDias; d++){
      var totalDia = materiaisPesagem.reduce(function(s,m){ return s+valorDoDia('pesagem', m.nome, d); },0);
      totalPorDiaTon.push(totalDia);
      producaoTotalTon += totalDia;
      if(metaDiariaTon>0 && totalDia>=metaDiariaTon) diasAtingiuMeta++;
      var totalDiaVerba = materiaisVerba.reduce(function(s,m){ return s+valorDoDia('verba', m.nome, d); },0);
      totalPorDiaVerba.push(totalDiaVerba);
      producaoTotalVerba += totalDiaVerba;
    }

    function kpi(label, value){ return '<div class="kpi-card"><div class="kpi-label">'+esc(label)+'</div><div class="kpi-value">'+value+'</div></div>'; }
    var kpiHtml = '<div class="kpi-row">' +
      (materiaisPesagem.length ? kpi('Meta mensal (ton)', brNum(metaMensalTon,2)) + kpi('Meta diária (ton)', brNum(metaDiariaTon,2)) + kpi('Produção total no mês (ton)', brNum(producaoTotalTon,2)) + kpi('Dias ≥ meta', diasAtingiuMeta+'/'+totalDias) : '') +
      (materiaisHora.length ? kpi('Meta mensal (h)', brNum(metaMensalHora,2)) : '') +
      (materiaisVerba.length ? kpi('Meta mensal (eventos)', brNum(metaMensalVerba,0)) + kpi('Eventos no mês', brNum(producaoTotalVerba,0)) : '') +
    '</div>';

    var colunas = materiaisPesagem.map(function(m){ return {tipo:'pesagem', nome:m.nome}; }).concat(materiaisHora.map(function(m){ return {tipo:'hora', nome:m.nome}; })).concat(materiaisVerba.map(function(m){ return {tipo:'verba', nome:m.nome}; }));
    var unidadeLabel = {pesagem:'ton', hora:'h', verba:'VB'};
    var theadHtml = '<tr><th>Dia</th>' + colunas.map(function(c){ return '<th>'+esc(c.nome)+' ('+unidadeLabel[c.tipo]+')</th>'; }).join('') + (materiaisPesagem.length?'<th>Total (ton)</th>':'') + (materiaisVerba.length?'<th>Total (VB)</th>':'') + '</tr>';

    var linhasHtml = '';
    for(var dia=1; dia<=totalDias; dia++){
      var dataISO = ano+'-'+String(mes).padStart(2,'0')+'-'+String(dia).padStart(2,'0');
      linhasHtml += '<tr><td>'+String(dia).padStart(2,'0')+'</td>';
      colunas.forEach(function(c){
        var v = valorDoDia(c.tipo, c.nome, dia);
        linhasHtml += '<td><input type="number" step="0.01" class="prod-input" data-tipo="'+c.tipo+'" data-material="'+esc(c.nome)+'" data-data="'+dataISO+'" value="'+(v?v:'')+'" placeholder="0,00" style="width:90px;padding:4px 6px;"></td>';
      });
      if(materiaisPesagem.length) linhasHtml += '<td class="num">'+brNum(totalPorDiaTon[dia-1],2)+'</td>';
      if(materiaisVerba.length) linhasHtml += '<td class="num">'+brNum(totalPorDiaVerba[dia-1],0)+'</td>';
      linhasHtml += '</tr>';
    }
    var linhaTotal = '<tr style="font-weight:700;background:var(--bg-soft);"><td>Total</td>' + colunas.map(function(c){
      var soma = 0;
      for(var dd=1; dd<=totalDias; dd++){ soma += valorDoDia(c.tipo, c.nome, dd); }
      return '<td>'+brNum(soma,2)+'</td>';
    }).join('') + (materiaisPesagem.length?'<td class="num">'+brNum(producaoTotalTon,2)+'</td>':'') + (materiaisVerba.length?'<td class="num">'+brNum(producaoTotalVerba,0)+'</td>':'') + '</tr>';

    var chartEntries = totalPorDiaTon.map(function(v,i){ return {label:'Dia '+String(i+1).padStart(2,'0'), value:v}; }).filter(function(e){ return e.value>0; });

    el.innerHTML = kpiHtml +
