  var usuariosCache = [];
  async function chamarGerenciarUsuarios(payload){
    var sessao = await supabaseClient.auth.getSession();
    var token = sessao.data && sessao.data.session ? sessao.data.session.access_token : null;
    if(!token) return {error:'Sessão expirada — faça login novamente.'};
    try{
      var res = await supabaseClient.functions.invoke('swift-service', {body: payload});
      if(res.error){ return {error: (res.error.message||'Erro ao chamar o servidor.')}; }
      if(res.data && res.data.error){ return {error: res.data.error}; }
      return res.data;
    }catch(e){ return {error: e.message||String(e)}; }
  }

