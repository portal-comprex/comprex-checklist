            '<button type="button" class="parada-remove" data-parada-remove="'+idx+'" title="Remover parada">×</button>' +
          '</div>' +
          '<div class="parada-servico-wrap" data-parada-servico-wrap="'+idx+'" style="display:'+(mostrarServico?'block':'none')+';">' +
            '<select data-parada-servico="'+idx+'" style="width:100%;">'+ '<option value="">Selecione o tipo de serviço…</option>' + tipoServicoOptions(p.tipoServico) +'</select>' +
          '</div>' +
        '</div>';
      }).join('');
    el.querySelectorAll('[data-parada-motivo]').forEach(function(sel){
      sel.addEventListener('change', function(){
        var idx = +sel.getAttribute('data-parada-motivo');
        formParadas[idx].motivo = sel.value;
        var wrap = el.querySelector('[data-parada-servico-wrap="'+idx+'"]');
        var mostrar = isMotivoManutencao(sel.value);
        if(wrap) wrap.style.display = mostrar ? 'block' : 'none';
        if(!mostrar) formParadas[idx].tipoServico = '';
        updateConsolidacao();
      });
    });
    el.querySelectorAll('[data-parada-servico]').forEach(function(sel){
      sel.addEventListener('change', function(){
        formParadas[+sel.getAttribute('data-parada-servico')].tipoServico = sel.value;
      });
    });
    function recompute(idx){
      var p = formParadas[idx];
      p.horas = paradaHoras(p);
      var disp = el.querySelector('[data-parada-horas-display="'+idx+'"]');
      if(disp) disp.textContent = brNum(p.horas,2);
      updateConsolidacao();
    }
    el.querySelectorAll('[data-parada-inicio]').forEach(function(inp){
      inp.addEventListener('input', function(){
        var idx = +inp.getAttribute('data-parada-inicio');
        formParadas[idx].inicio = inp.value;
        recompute(idx);
      });
    });
    el.querySelectorAll('[data-parada-termino]').forEach(function(inp){
      inp.addEventListener('input', function(){
        var idx = +inp.getAttribute('data-parada-termino');
        formParadas[idx].termino = inp.value;
        recompute(idx);
      });
    });
    el.querySelectorAll('[data-parada-remove]').forEach(function(btn){
      btn.onclick = function(){
        formParadas.splice(+btn.getAttribute('data-parada-remove'),1);
        renderParadasEditor();
        updateConsolidacao();
      };
    });
