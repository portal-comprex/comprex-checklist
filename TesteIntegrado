      var intIni = document.getElementById('apIntIni').value;
      var intFim = document.getElementById('apIntFim').value;
      var saida = document.getElementById('apSaida').value;
      var hi = parseFloat(document.getElementById('apHi').value);
      var hf = parseFloat(document.getElementById('apHf').value);

      if(!data){ errBox.innerHTML = '<div class="form-error">Informe a data.</div>'; return; }
      if(!equipamentoId){ errBox.innerHTML = '<div class="form-error">Equipamento não reconhecido — digite o código ou escolha um da lista.</div>'; return; }
      if(!ordemId){ errBox.innerHTML = '<div class="form-error">Ordem não reconhecida — digite o nome ou escolha uma da lista.</div>'; return; }
      if(!operadorTexto){ errBox.innerHTML = '<div class="form-error">Informe o operador — este campo é obrigatório.</div>'; return; }
      if(!operadorRegistrado){ errBox.innerHTML = '<div class="form-error">Operador não encontrado no cadastro. Cadastre-o em Cadastros → Operadores antes de lançar esta apropriação.</div>'; return; }
      if(!escala){ errBox.innerHTML = '<div class="form-error">Selecione a escala (jornada de trabalho) do operador.</div>'; return; }
      if(!entrada || !saida){ errBox.innerHTML = '<div class="form-error">Informe entrada e saída do operador.</div>'; return; }
      if(tipoIntervalo!=='Sem intervalo' && (!intIni || !intFim)){ errBox.innerHTML = '<div class="form-error">Informe o início e o fim do intervalo, ou selecione "Sem intervalo".</div>'; return; }
      var horasOperador = computeHorasOperador(entrada, tipoIntervalo, intIni, intFim, saida);
      if(horasOperador===null || horasOperador<=0){ errBox.innerHTML = '<div class="form-error">Verifique os horários informados — o intervalo não pode ser maior ou igual ao turno.</div>'; return; }
      if(isNaN(hi) || isNaN(hf)){ errBox.innerHTML = '<div class="form-error">Informe os horímetros inicial e final.</div>'; return; }
      if(hf < hi){ errBox.innerHTML = '<div class="form-error">Horímetro final não pode ser menor que o horímetro inicial — verifique os valores.</div>'; return; }
      var horasHorimetro = Math.round((hf-hi)*100)/100;
