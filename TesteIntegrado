  function dashboardApropriacoesFiltradas(){
    var de = document.getElementById('dashDe').value;
    var ate = document.getElementById('dashAte').value;
    var cliente = document.getElementById('dashCliente').value.trim();
    var ordemId = resolverOrdemFiltro('dashOrdem');
    var equipId = resolverEquipFiltro('dashEquip');
    var operador = document.getElementById('dashOperador').value.trim();
    var ordensValidas = null;
    if(cliente || ordemId){
      ordensValidas = {};
      state.ordens.forEach(function(o){ if((!cliente||o.cliente===cliente) && (!ordemId||o.id===ordemId)) ordensValidas[o.id]=true; });
    }
    return state.apropriacoes.filter(function(a){
      if(de && a.data<de) return false;
      if(ate && a.data>ate) return false;
      if(ordensValidas && !ordensValidas[a.ordemId]) return false;
      if(equipId && a.equipamentoId!==equipId) return false;
      if(operador && a.operador!==operador) return false;
      return true;
    });
  }
