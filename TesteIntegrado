  // Retorna a versão da tarifa (por ordem+serviço) vigente numa data específica — permite que preços
  // reajustados no cadastro não alterem retroativamente medições já feitas em meses anteriores.
  function tarifaVigenteNaData(ordemId, servico, data){
    var candidatas = state.tarifasProducao.filter(function(t){
      return t.ordemId===ordemId && t.servico===servico &&
        (!t.vigenciaInicio || t.vigenciaInicio<=data) &&
        (!t.vigenciaFim || t.vigenciaFim>=data);
    });
    if(candidatas.length===0) return null;
    candidatas.sort(function(a,b){ return (b.vigenciaInicio||'').localeCompare(a.vigenciaInicio||''); });
    return candidatas[0];
  }

