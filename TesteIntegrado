  function renderIndicadoresFinanceiros(lista){
    var porEquipFin = {};
    lista.forEach(function(a){
      if(!porEquipFin[a.equipamentoId]) porEquipFin[a.equipamentoId] = [];
      porEquipFin[a.equipamentoId].push(a);
    });
    var totalToneladas = 0, receitaProducaoTotal = 0, receitaMedicaoTotal = 0;
    var linhasEquip = Object.keys(porEquipFin).map(function(eid){
      var l = porEquipFin[eid];
      var toneladas = l.reduce(function(s,a){ return s+(a.producaoToneladas||0); },0);
      var receitaProducao = l.reduce(function(s,a){ return s+(a.valorProducaoCalculado||0); },0);
      var horasHorimetro = horimetroDoEquipamento(l);
      var ordensDoEquip = Array.from(new Set(l.map(function(a){ return a.ordemId; })));
      var tarifasDoEquip = state.tarifasHora.filter(function(t){ return ordensDoEquip.indexOf(t.ordemId)>-1; });
      var receitaMedicao = tarifasDoEquip.reduce(function(s,t){
        var lancTarifa = l.filter(function(a){ return a.ordemId===t.ordemId; });
        var horasEf = lancTarifa.reduce(function(ss,a){ return ss+horasEfetivasMedicao(a, t.baseCalculo); },0);
        return s + horasEf*t.valorHora;
      },0);
      var receitaTotal = receitaProducao+receitaMedicao;
      totalToneladas += toneladas; receitaProducaoTotal += receitaProducao; receitaMedicaoTotal += receitaMedicao;
      return {equipamentoId:eid, toneladas:toneladas, horasHorimetro:horasHorimetro, receitaProducao:receitaProducao, receitaMedicao:receitaMedicao, receitaTotal:receitaTotal};
    }).sort(function(a,b){ return b.receitaTotal-a.receitaTotal; }).slice(0,10);

    var totalHorimetroGeral = horimetroAgregado(lista);
    var receitaTotalGeral = receitaProducaoTotal + receitaMedicaoTotal;
    var receitaPorHora = totalHorimetroGeral>0 ? receitaTotalGeral/totalHorimetroGeral : 0;
    var receitaPorTonelada = totalToneladas>0 ? receitaProducaoTotal/totalToneladas : 0;
    var produtividadeFisica = totalHorimetroGeral>0 ? totalToneladas/totalHorimetroGeral : 0;

    function kpi(label, value, cls){ return '<div class="kpi-card"><div class="kpi-label">'+esc(label)+'</div><div class="kpi-value'+(cls?' '+cls:'')+'">'+value+'</div></div>'; }
    document.getElementById('indFinKpiRow').innerHTML =
      kpi('Receita total (produção+medição)', 'R$ '+brNum(receitaTotalGeral,2)) +
      kpi('Receita por hora de horímetro', 'R$ '+brNum(receitaPorHora,2)) +
      kpi('Receita por tonelada', 'R$ '+brNum(receitaPorTonelada,2)) +
      kpi('Produtividade física (t/h)', brNum(produtividadeFisica,3));

    var bodyFin = document.getElementById('indFinBody');
    if(linhasEquip.length===0){
      bodyFin.innerHTML = '<tr class="empty-row"><td colspan="6">Nenhuma receita (produção ou medição) no período/filtro selecionado.</td></tr>';
      return;
    }
    bodyFin.innerHTML = linhasEquip.map(function(l){
      var eq = getEquip(l.equipamentoId);
      var rPorHora = l.horasHorimetro>0 ? l.receitaTotal/l.horasHorimetro : 0;
      return '<tr><td>'+(eq?'<span class="plate">'+esc(eq.codigo)+'</span>':'<span class="muted-tag">(removido)</span>')+'</td>'+
        '<td class="num">'+brNum(l.toneladas,2)+'</td><td class="num">'+brNum(l.horasHorimetro,1)+'</td>'+
        '<td class="num">'+brNum(l.receitaProducao,2)+'</td><td class="num">'+brNum(l.receitaMedicao,2)+'</td>'+
        '<td class="num">'+brNum(l.receitaTotal,2)+'</td>'+
        '<td class="num">'+brNum(rPorHora,2)+'</td></tr>';
    }).join('');
  }

