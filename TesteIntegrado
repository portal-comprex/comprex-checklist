  function renderConsolidado(){
    recalcularHorimetrosEfetivos();
    populateConsFilters();
    var cliente = document.getElementById('consCliente').value.trim();
    var ordemId = resolverOrdemFiltro('consOrdem');
    var operadorFiltro = document.getElementById('consOperador').value.trim();
    var equipId = resolverEquipFiltro('consEquip');
    var de = document.getElementById('consDe').value;
    var ate = document.getElementById('consAte').value;
    var ordensValidas = {};
    state.ordens.forEach(function(o){ if((!cliente||o.cliente===cliente) && (!ordemId||o.id===ordemId)) ordensValidas[o.id]=true; });

    var groups = {};
    var listaFiltrada = [];
    state.apropriacoes.forEach(function(a){
      if(!ordensValidas[a.ordemId]) return;
      if(operadorFiltro && a.operador!==operadorFiltro) return;
      if(equipId && a.equipamentoId!==equipId) return;
      if(de && a.data<de) return;
      if(ate && a.data>ate) return;
      listaFiltrada.push(a);
      var key = a.ordemId+'||'+a.equipamentoId;
      if(!groups[key]) groups[key] = {ordemId:a.ordemId, equipamentoId:a.equipamentoId, lista:[], operador:0, parada:0};
      groups[key].lista.push(a);
      groups[key].operador += a.horasOperador;
      groups[key].parada += paradasTotal(a);
    });
    var rows = Object.values(groups).map(function(g){
      var limites = horimetroLimitesLista(g.lista);
      var diasTrabalhados = new Set(g.lista.map(function(a){ return a.data; })).size;
      return {ordemId:g.ordemId, equipamentoId:g.equipamentoId, horimetro:horimetroDoEquipamento(g.lista), operador:g.operador, parada:g.parada, hInicial:limites.inicial, hFinal:limites.final, diasTrabalhados:diasTrabalhados};
    }).sort(function(a,b){ return b.horimetro-a.horimetro; });

    var totalHorimetro = rows.reduce(function(s,r){ return s+r.horimetro; },0);
    var totalOperador = rows.reduce(function(s,r){ return s+r.operador; },0);
    var eficiencia = totalOperador>0 ? Math.round(totalHorimetro/totalOperador*100) : 0;
    var distinctEquip = new Set(rows.map(function(r){ return r.equipamentoId; })).size;
    function kpi(label, value, pct, color){
      return '<div class="kpi-card"><div class="kpi-label">'+esc(label)+'</div><div class="kpi-value">'+value+'</div>' +
        (pct!==null ? ('<div class="kpi-gauge"><div class="kpi-gauge-fill" style="width:'+Math.min(pct,100)+'%;background:'+color+';"></div></div>') : '') +
      '</div>';
    }
    document.getElementById('consKpiRow').innerHTML =
      kpi('Equipamentos alocados', distinctEquip, null, '') +
      kpi('Horas de horímetro', brNum(totalHorimetro,1), null, '') +
      kpi('Horas programadas', brNum(totalOperador,1), null, '') +
      kpi('Eficiência', eficiencia+'%', eficiencia, effColor(eficiencia));

    var body = document.getElementById('consBody');
    var bodyOperador = document.getElementById('consOperadorBody');
    if(rows.length===0){
      body.innerHTML = '<tr class="empty-row"><td colspan="12">Nenhum lançamento para os filtros selecionados.</td></tr>';
      bodyOperador.innerHTML = '<tr class="empty-row"><td colspan="4">Nenhum lançamento para os filtros selecionados.</td></tr>';
      document.getElementById('consOperadorNote').style.display = 'none';
      return;
    }
    body.innerHTML = rows.map(function(r){
      var eq = getEquip(r.equipamentoId);
      var ord = getOrdem(r.ordemId);
      var eff = r.operador>0 ? Math.round(r.horimetro/r.operador*100) : 0;
      return '<tr><td>'+(ord?(clienteNumero(ord.cliente)?esc(clienteNumero(ord.cliente))+' ':''):'')+(ord?esc(ord.cliente):'—')+'</td><td>'+(ord&&ord.numero?esc(ord.numero)+' ':'')+(ord?esc(ord.nome):'—')+'</td>' +
        '<td>'+(eq?'<span class="plate">'+esc(eq.codigo)+'</span>':'<span class="muted-tag">(removido)</span>')+'</td>' +
        '<td>'+(eq?esc(eq.tipo):'—')+'</td>' +
        '<td class="num">'+brNum(r.operador,2)+'</td>' +
        '<td class="num">'+(r.hInicial!==null?brNum(r.hInicial,1):'—')+'</td>' +
        '<td class="num">'+(r.hFinal!==null?brNum(r.hFinal,1):'—')+'</td>' +
        '<td class="num">'+brNum(r.horimetro,2)+'</td>' +
        '<td class="num">'+brNum(r.parada,2)+'</td><td class="num">'+r.diasTrabalhados+'</td>' +
        '<td class="num '+effClass(eff)+'">'+eff+'%</td></tr>';
    }).join('');

    var porOperador = {};
    var porOperadorDia = {};
    var temSobreposicao = false;
    listaFiltrada.forEach(function(a){
      if(!a.operador) return;
      if(!porOperador[a.operador]) porOperador[a.operador] = {dias:new Set(), equipamentos:new Set(), horasProgramada:0};
      porOperador[a.operador].dias.add(a.data);
      porOperador[a.operador].equipamentos.add(a.equipamentoId);
      porOperador[a.operador].horasProgramada += a.horasOperador;
      var chaveDia = a.operador+'||'+a.data;
      if(!porOperadorDia[chaveDia]) porOperadorDia[chaveDia] = new Set();
      porOperadorDia[chaveDia].add(a.equipamentoId);
      if(porOperadorDia[chaveDia].size>1) temSobreposicao = true;
    });
    document.getElementById('consOperadorNote').style.display = temSobreposicao ? 'block' : 'none';
    var linhasOperador = Object.keys(porOperador).map(function(nome){
