  // Combobox estilo filtro do Excel: digitar filtra a lista, clicar seleciona, itens já vêm organizados
  // (na ordem em que itemsProvider() os devolve). groupLabels (opcional, mesmo tamanho da lista) agrupa
  // visualmente por categoria (ex.: cliente), como um cabeçalho fixo antes de cada grupo.
  function wireComboBox(inputId, listId, itemsProvider, groupLabels, onSelect, allLabel){
    var input = document.getElementById(inputId);
    var list = document.getElementById(listId);
    if(!input || !list) return;
    // Evita empilhar listeners duplicados quando a função é chamada de novo em cada re-render
    // sobre os mesmos elementos (que não são recriados via innerHTML, ao contrário de outros usos).
    if(input.dataset.comboWired){
      input.__comboItemsProvider = itemsProvider;
      input.__comboGroupLabels = groupLabels;
      input.__comboOnSelect = onSelect;
      input.__comboAllLabel = allLabel;
      return;
    }
    input.dataset.comboWired = '1';
    input.__comboItemsProvider = itemsProvider;
    input.__comboGroupLabels = groupLabels;
    input.__comboOnSelect = onSelect;
    input.__comboAllLabel = allLabel;
    var highlightIdx = -1;
    function itemEls(){ return Array.prototype.slice.call(list.querySelectorAll('.combo-item')); }
    function applyHighlight(){
      var els = itemEls();
      els.forEach(function(el,i){ el.classList.toggle('active', i===highlightIdx); });
      if(highlightIdx>=0 && els[highlightIdx]) els[highlightIdx].scrollIntoView({block:'nearest'});
    }
    function selectItem(el){
      input.value = el.hasAttribute('data-all') ? '' : el.getAttribute('data-value');
      list.classList.remove('open');
      input.dispatchEvent(new Event('change'));
      if(input.__comboOnSelect) input.__comboOnSelect(el.hasAttribute('data-all') ? null : el.getAttribute('data-idx'));
    }
    function renderList(filtrar){
      var texto = filtrar ? input.value.trim().toLowerCase() : '';
      var items = input.__comboItemsProvider();
      var grupos = input.__comboGroupLabels;
      var lastGroup = null;
      var html = '';
      var count = 0;
      if(input.__comboAllLabel && !texto){
        html += '<div class="combo-item combo-item-all" data-all="1">'+esc(input.__comboAllLabel)+'</div>';
        count++;
      }
      items.forEach(function(label, idx){
        if(texto && label.toLowerCase().indexOf(texto)===-1) return;
        var grupo = grupos ? grupos[idx] : null;
        if(grupo && grupo!==lastGroup){ html += '<div class="combo-group">'+esc(grupo)+'</div>'; lastGroup = grupo; }
        html += '<div class="combo-item" data-value="'+esc(label)+'" data-idx="'+idx+'">'+esc(label)+'</div>';
        count++;
      });
      list.innerHTML = count>0 ? html : '<div class="combo-empty">Nenhum resultado encontrado</div>';
      list.classList.add('open');
      highlightIdx = -1;
      list.querySelectorAll('.combo-item').forEach(function(el){
        el.addEventListener('mousedown', function(e){ e.preventDefault(); selectItem(el); });
      });
    }
    input.addEventListener('focus', function(){ renderList(false); input.select(); });
    input.addEventListener('click', function(){ renderList(false); });
    input.addEventListener('input', function(){ renderList(true); });
    input.addEventListener('blur', function(){ setTimeout(function(){ list.classList.remove('open'); }, 150); });
    input.addEventListener('keydown', function(e){
      var els;
      if(e.key==='Escape'){ list.classList.remove('open'); return; }
      if(e.key==='ArrowDown'){
        e.preventDefault();
        if(!list.classList.contains('open')) renderList(false);
        els = itemEls();
        if(els.length){ highlightIdx = Math.min(highlightIdx+1, els.length-1); applyHighlight(); }
        return;
      }
      if(e.key==='ArrowUp'){
        e.preventDefault();
        els = itemEls();
        if(els.length){ highlightIdx = Math.max(highlightIdx-1, 0); applyHighlight(); }
        return;
      }
      if(e.key==='Enter'){
        e.preventDefault();
        els = itemEls();
        if(!els.length) return;
        var alvo = highlightIdx>=0 ? els[highlightIdx] : els[0];
        selectItem(alvo);
      }
    });
  }

