      if(!porDia[a.data]) porDia[a.data] = {horimetro:[], producao:0};
      porDia[a.data].horimetro.push(a);
      porDia[a.data].producao += (a.producaoToneladas||0);
    });
    var dias = Object.keys(porDia).sort();
    var el = document.getElementById('tendenciaChart');
    if(dias.length===0){ el.innerHTML = '<div class="empty-state" style="padding:20px;">Nenhum lançamento no período selecionado.</div>'; return; }
    var horimetroSerie = dias.map(function(d){ return Math.round(horimetroAgregado(porDia[d].horimetro)*10)/10; });
    var producaoSerie = dias.map(function(d){ return Math.round(porDia[d].producao*10)/10; });
    var w = 480, h = 170, padL = 34, padR = 10, padT = 10, padB = 24;
    var innerW = w-padL-padR, innerH = h-padT-padB;
    var maxH = Math.max.apply(null, horimetroSerie.concat([1]));
    var maxP = Math.max.apply(null, producaoSerie.concat([1]));
    function pathFor(serie, max){
      return serie.map(function(v,i){
        var x = padL + (serie.length>1 ? i/(serie.length-1)*innerW : innerW/2);
        var y = padT + innerH - (v/max*innerH);
        return (i===0?'M':'L')+x.toFixed(1)+','+y.toFixed(1);
      }).join(' ');
    }
    var pathH = pathFor(horimetroSerie, maxH);
    var pathP = pathFor(producaoSerie, maxP);
    var pointsH = horimetroSerie.map(function(v,i){
      var x = padL + (horimetroSerie.length>1 ? i/(horimetroSerie.length-1)*innerW : innerW/2);
      var y = padT + innerH - (v/maxH*innerH);
      return '<circle cx="'+x.toFixed(1)+'" cy="'+y.toFixed(1)+'" r="2.6" fill="#2E75B6"><title>'+brDate(dias[i])+': '+brNum(v,1)+'h</title></circle>';
    }).join('');
    var pointsP = producaoSerie.map(function(v,i){
      var x = padL + (producaoSerie.length>1 ? i/(producaoSerie.length-1)*innerW : innerW/2);
      var y = padT + innerH - (v/maxP*innerH);
      return '<circle cx="'+x.toFixed(1)+'" cy="'+y.toFixed(1)+'" r="2.6" fill="#A67900"><title>'+brDate(dias[i])+': '+brNum(v,1)+'t</title></circle>';
    }).join('');
    var xLabels = dias.map(function(d,i){
      if(dias.length>10 && i%Math.ceil(dias.length/8)!==0) return '';
      var x = padL + (dias.length>1 ? i/(dias.length-1)*innerW : innerW/2);
      return '<text x="'+x.toFixed(1)+'" y="'+(h-6)+'" font-size="9" fill="#5C6B78" text-anchor="middle" font-family="Arial">'+brDate(dias[i]).slice(0,5)+'</text>';
    }).join('');
    el.innerHTML =
      '<div class="legend" style="margin-bottom:6px;"><div class="legend-item"><span class="led" style="background:#2E75B6;"></span>Horas de horímetro</div><div class="legend-item"><span class="led" style="background:#A67900;"></span>Produção (t)</div></div>' +
      '<svg viewBox="0 0 '+w+' '+h+'" width="100%" height="140" preserveAspectRatio="xMinYMin meet">' +
        '<line x1="'+padL+'" y1="'+padT+'" x2="'+padL+'" y2="'+(padT+innerH)+'" stroke="#DCE3EA"/>' +
        '<line x1="'+padL+'" y1="'+(padT+innerH)+'" x2="'+(padL+innerW)+'" y2="'+(padT+innerH)+'" stroke="#DCE3EA"/>' +
        '<path d="'+pathH+'" fill="none" stroke="#2E75B6" stroke-width="2"/>' + pointsH +
        '<path d="'+pathP+'" fill="none" stroke="#A67900" stroke-width="2" stroke-dasharray="4 3"/>' + pointsP +
        xLabels +
      '</svg>' +
      '<div class="muted-tag" style="margin-top:4px;">Cada série usa sua própria escala (horas x toneladas) para comparar a tendência.</div>';
  }

