  function updateConsolidacao(){
    var box = document.getElementById('consolBox');
    if(!box) return;
    var entrada = document.getElementById('apEntrada').value;
    var tipoIntervalo = document.getElementById('apTipoIntervalo').value;
    var intIni = document.getElementById('apIntIni').value;
    var intFim = document.getElementById('apIntFim').value;
    var saida = document.getElementById('apSaida').value;
    var hiRaw = document.getElementById('apHi').value;
    var hfRaw = document.getElementById('apHf').value;
    var hi = parseFloat(hiRaw);
    var hf = parseFloat(hfRaw);

    var warnEl = document.getElementById('apHorimetroWarn');
    if(warnEl){
      if(hiRaw!=='' && hfRaw!=='' && !isNaN(hi) && !isNaN(hf) && hf < hi){
        warnEl.innerHTML = '<div class="form-error" style="margin-top:-6px;">Horímetro final não pode ser menor que o inicial.</div>';
        document.getElementById('apHf').style.borderColor = 'var(--danger)';
      } else {
        warnEl.innerHTML = '';
        document.getElementById('apHf').style.borderColor = '';
      }
    }

