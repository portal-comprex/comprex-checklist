      var servicoTarifa = '', valorUnitarioTarifa = 0, valorProducaoCalculado = 0;
      var tarifasOrdem = tarifasDaOrdem(ordemId);
      var servicoSelEl = document.getElementById('apServico');
      if(tarifasOrdem.length>0 && servicoSelEl && servicoSelEl.value!==''){
        var tSel = tarifasOrdem[+servicoSelEl.value];
        if(tSel){
          servicoTarifa = tSel.servico;
          valorUnitarioTarifa = tSel.valor;
        }
      }
      var record = {
        id: state.editingApropriacaoId || uid(), equipamentoId: equipamentoId, ordemId: ordemId, data: data,
        dataFim: isOvernightShift(entrada, saida) ? addDaysISO(data, 1) : data,
        operador: operador, numeroPD: numeroPD, escala: escala, turno: turno,
        entrada: entrada, tipoIntervalo: tipoIntervalo,
        intervaloInicio: tipoIntervalo==='Sem intervalo' ? '' : intIni,
        intervaloFim: tipoIntervalo==='Sem intervalo' ? '' : intFim,
        saida: saida, horasOperador: horasOperador,
        horimetroInicial: hi, horimetroFinal: hf, horasHorimetro: horasHorimetro,
        servicoTarifa: servicoTarifa, valorUnitarioTarifa: valorUnitarioTarifa, valorProducaoCalculado: valorProducaoCalculado,
        paradas: formParadas.filter(function(p){ return p.horas>0; }), observacao: ''
      };
      if(state.editingApropriacaoId){
        state.apropriacoes = state.apropriacoes.map(function(x){ return x.id===record.id ? record : x; });
      } else {
        state.apropriacoes.push(record);
      }
      var wasEditing = !!state.editingApropriacaoId;
      var ok = await saveList('apropriacoes_v7', state.apropriacoes);
      toast(ok ? (wasEditing ? 'Apropriação atualizada.' : 'Apropriação lançada.') : 'Lançamento salvo localmente — houve um problema ao sincronizar.');
      state.editingApropriacaoId = null;
      renderApropriacaoForm();
      renderApropriacoesTable();
      renderDashboard();
      renderCadastro();
    };
  }

