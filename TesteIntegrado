      var ordemObj = state.ordens.filter(function(o){ return ordemDescricao(o)===ordemTexto; })[0];
      var ordemId = ordemObj ? ordemObj.id : null;
      var data = document.getElementById('apData').value;
      var operadorTexto = normalizarEspacos(document.getElementById('apOperador').value);
      var operadorRegistrado = state.operadores.filter(function(o){
        return o.nome.toLowerCase()===operadorTexto.toLowerCase() || (o.matricula && o.matricula.toLowerCase()===operadorTexto.toLowerCase());
