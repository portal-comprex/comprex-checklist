  document.getElementById('exportBoletimBtn').addEventListener('click', async function(){
    var ordemId = resolverOrdemFiltro('bmOrdem');
    if(!ordemId){ toast('Selecione uma ordem antes de exportar.'); return; }
    var ord = getOrdem(ordemId);
    var de = document.getElementById('bmDe').value, ate = document.getElementById('bmAte').value;
    var calc = window.__bmUltimoCalculo;
    if(!calc){ toast('Aguarde o cálculo do boletim antes de exportar.'); return; }
    if(calc.linhas.length>6){
      toast('Este modelo (FM-COM-003) só tem 6 linhas para serviços — exportando só os 6 primeiros.');
    }

    // Carrega o modelo oficial (FM-COM-003) tal como está, preservando 100% do layout/formatação —
    // só preenchemos os campos de entrada; os totais e descontos usam as próprias fórmulas do modelo.
    function b64ParaArrayBuffer(b64){
      var bin = atob(b64);
      var bytes = new Uint8Array(bin.length);
      for(var i=0;i<bin.length;i++) bytes[i] = bin.charCodeAt(i);
      return bytes.buffer;
    }
    var wb = new ExcelJS.Workbook();
    await wb.xlsx.load(b64ParaArrayBuffer(BM_TEMPLATE_B64));
    var ws = wb.getWorksheet('Medição');

    // Cabeçalho
    ws.getCell('O7').value = brDate(todayISO());
    ws.getCell('H8').value = ord.cliente;
    ws.getCell('H9').value = ord.cnpj||'';
    ws.getCell('H10').value = '';
    ws.getCell('H12').value = ord.local||'';
    ws.getCell('Q8').value = ord.numero||'';

    // Natureza da Medição — linhas 17 a 22 (limite do modelo oficial)
    var linhasParaExportar = calc.linhas.slice(0,6);
    linhasParaExportar.forEach(function(l, i){
      var linha = 17+i;
      ws.getCell('B'+linha).value = l.servico;
      ws.getCell('H'+linha).value = brDate(de);
      ws.getCell('I'+linha).value = brDate(ate);
      ws.getCell('J'+linha).value = l.unidade;
      ws.getCell('K'+linha).value = l.valorUnit;
      ws.getCell('L'+linha).value = l.qtdAnterior;
      ws.getCell('M'+linha).value = l.qtdAtual;
      // Gravamos os totais da linha como valor já calculado (não fórmula): o Excel/LibreOffice
      // às vezes não recalcula corretamente fórmulas "compartilhadas" reescritas por biblioteca,
      // então garantimos o número certo independente disso.
      ws.getCell('N'+linha).value = l.qtdAcumulado;
      ws.getCell('O'+linha).value = l.valorAnterior;
      ws.getCell('P'+linha).value = l.valorAtual;
      ws.getCell('Q'+linha).value = l.valorAcumulado;
    });

    // Totais e descontos — mesmo raciocínio: gravamos os valores já calculados em vez de
    // depender das fórmulas em cascata do modelo original.
    ws.getCell('O23').value = calc.linhas.reduce(function(s,l){return s+l.valorAnterior;},0);
    ws.getCell('P23').value = calc.totalMedicao;
    ws.getCell('Q23').value = calc.linhas.reduce(function(s,l){return s+l.valorAcumulado;},0);
    ws.getCell('O9').value = calc.totalLiquido;
    ws.getCell('O26').value = calc.maoObraPct/100;
    ws.getCell('P26').value = calc.totalMedicao;
    ws.getCell('O27').value = calc.inssPct/100;
    ws.getCell('Q27').value = calc.valorInss;
    ws.getCell('O28').value = calc.issPct/100;
    ws.getCell('Q28').value = calc.valorIss;
    if(calc.outras){ ws.getCell('Q29').value = calc.outras; }
    ws.getCell('Q30').value = calc.totalDesconto;
    ws.getCell('P31').value = calc.totalLiquido;

    var buffer = await wb.xlsx.writeBuffer();
    var blob = new Blob([buffer], {type:'application/octet-stream'});
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = 'FM-COM-003_boletim_medicao_'+(ord.numero||ord.id)+'_'+de+'_a_'+ate+'.xlsx';
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });
