      else { state.tarifasHora.push(record); }
      var ok = await saveList('tarifas_hora_v2', state.tarifasHora);
      closeModal();
      toast(ok?'Tarifa salva.':'Salva localmente — problema ao sincronizar.');
      renderMedicao();
    };
