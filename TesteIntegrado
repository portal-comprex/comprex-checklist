      kpi('Horas de segurança', brNum(geral.totalSeguranca,1));

    var porTipo = horasPorTipoParada(lista);
    var total = Object.keys(porTipo).reduce(function(s,k){ return s+porTipo[k]; },0);
    var entries = Object.keys(porTipo).map(function(k){ return {tipo:k, horas:porTipo[k]}; })
      .filter(function(e){ return e.horas>0; }).sort(function(a,b){ return b.horas-a.horas; });
