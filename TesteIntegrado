      var ordenada = porEquip[eid].slice().sort(function(a,b){
        if(a.data<b.data) return -1;
        if(a.data>b.data) return 1;
        return (a.entrada||'') < (b.entrada||'') ? -1 : 1;
      });
      var ultimoConhecido = null;
      ordenada.forEach(function(a){
        a.horimetroInicialEfetivo = (a.horimetroInicial===0 && ultimoConhecido!==null) ? ultimoConhecido : a.horimetroInicial;
        a.horimetroFinalEfetivo = (a.horimetroFinal===0 && ultimoConhecido!==null) ? ultimoConhecido : a.horimetroFinal;
        if(a.horimetroFinalEfetivo !== 0) ultimoConhecido = a.horimetroFinalEfetivo;
        else if(a.horimetroInicialEfetivo !== 0) ultimoConhecido = a.horimetroInicialEfetivo;
      });
    });
  }

  function horimetroLimitesLista(lista){
    var equipIds = {};
    (lista||[]).forEach(function(a){ equipIds[a.equipamentoId] = true; });
    var ids = Object.keys(equipIds);
    if(ids.length !== 1 || lista.length===0) return {inicial:null, final:null};
    var ordenada = lista.slice().sort(function(a,b){
      if(a.data<b.data) return -1;
      if(a.data>b.data) return 1;
      return (a.entrada||'') < (b.entrada||'') ? -1 : 1;
    });
    return {inicial: ordenada[0].horimetroInicialEfetivo!==undefined?ordenada[0].horimetroInicialEfetivo:ordenada[0].horimetroInicial,
            final: (function(u){ return u.horimetroFinalEfetivo!==undefined?u.horimetroFinalEfetivo:u.horimetroFinal; })(ordenada[ordenada.length-1])};
  }

  function horimetroDoEquipamento(lista){
    if(!lista || lista.length===0) return 0;
    var ordenada = lista.slice().sort(function(a,b){
      if(a.data<b.data) return -1;
      if(a.data>b.data) return 1;
      return (a.entrada||'') < (b.entrada||'') ? -1 : 1;
    });
    var primeiro = ordenada[0], ultimo = ordenada[ordenada.length-1];
    var hi = primeiro.horimetroInicialEfetivo!==undefined ? primeiro.horimetroInicialEfetivo : primeiro.horimetroInicial;
    var hf = ultimo.horimetroFinalEfetivo!==undefined ? ultimo.horimetroFinalEfetivo : ultimo.horimetroFinal;
    return Math.round((hf - hi)*100)/100;
  }
  // Soma o horímetro (método acima) de vários equipamentos dentro de uma lista de apropriações.
  function horimetroAgregado(lista){
    var porEquip = {};
    (lista||[]).forEach(function(a){
      if(!porEquip[a.equipamentoId]) porEquip[a.equipamentoId] = [];
      porEquip[a.equipamentoId].push(a);
    });
    var total = 0;
    Object.keys(porEquip).forEach(function(eid){ total += horimetroDoEquipamento(porEquip[eid]); });
    return Math.round(total*100)/100;
  }

  /* ---- Indicadores: Disponibilidade Mecânica, Utilização, OEE (adaptado), MTBF, MTTR ---- */
  function isMotivoManutencao(motivo){
    if(motivo==='Manutenção') return true; // compatibilidade com dados antigos importados
    var m = state.motivosParada.filter(function(x){ return x.descricao===motivo; })[0];
    return m ? m.tipo==='Manutenção' : false;
  }
  function horasManutencao(ap){ return (ap.paradas||[]).filter(function(p){ return isMotivoManutencao(p.motivo); }).reduce(function(s,p){ return s+(p.horas||0); },0); }
  function contarParadasManutencao(ap){ return (ap.paradas||[]).filter(function(p){ return isMotivoManutencao(p.motivo); }).length; }
  // Classifica o tipo de um motivo de parada usando o catálogo editável (Manutenção/Operacional/Segurança/Outro).
  // Compatível com dados antigos que usavam o texto genérico "Manutenção".
  function tipoDeParada(motivo){
    if(motivo==='Manutenção') return 'Manutenção';
    var m = state.motivosParada.filter(function(x){ return x.descricao===motivo; })[0];
    return m ? m.tipo : 'Outro';
  }
  function horasPorTipoParada(lista){
    var acc = {'Manutenção':0, 'Operacional':0, 'Segurança':0, 'Outro':0};
    lista.forEach(function(a){
      (a.paradas||[]).forEach(function(p){
        var tipo = tipoDeParada(p.motivo);
        if(!(tipo in acc)) acc[tipo] = 0;
        acc[tipo] += (p.horas||0);
      });
    });
    return acc;
  }
  function contarParadasPorTipo(lista, tipo){
    var n = 0;
    lista.forEach(function(a){ (a.paradas||[]).forEach(function(p){ if(tipoDeParada(p.motivo)===tipo) n++; }); });
    return n;
  }

  // Calcula os indicadores para uma lista de apropriações (já filtrada pelo escopo desejado).
  // Fórmulas (adaptadas para uso com os dados do painel, sem base de horas-calendário):
  //  Disponibilidade Mecânica (DM) = (Horas Programadas - Horas de Manutenção) / Horas Programadas
  //  Utilização (UT)               = Horas de Horímetro / (Horas Programadas - Horas de Manutenção)
  //  OEE adaptado                  = DM x UT
  //  MTBF (h)                      = Horas Programadas / nº de paradas de manutenção
  //  MTTR (h)                      = Horas de Manutenção / nº de paradas de manutenção
  function calcularIndicadores(lista){
    lista = lista || [];
    var totalProgramada = 0, totalManutencao = 0, totalParadaGeral = 0, numParadasManut = 0;
    lista.forEach(function(a){
      totalProgramada += a.horasOperador;
      totalManutencao += horasManutencao(a);
      totalParadaGeral += paradasTotal(a);
      numParadasManut += contarParadasManutencao(a);
    });
    var totalHorimetro = horimetroAgregado(lista);
    var horasDisponiveis = Math.max(totalProgramada - totalManutencao, 0);
    var dm = totalProgramada>0 ? (horasDisponiveis/totalProgramada*100) : 0;
    var ut = horasDisponiveis>0 ? (totalHorimetro/horasDisponiveis*100) : 0;
    var oee = (dm/100)*(ut/100)*100;
    var mtbf = numParadasManut>0 ? totalProgramada/numParadasManut : null;
    var mttr = numParadasManut>0 ? totalManutencao/numParadasManut : null;
    var naoApontado = Math.round((totalProgramada - totalHorimetro - totalParadaGeral)*100)/100;

    // Indicadores por tipo de parada — separam perda mecânica (Manutenção) de perda operacional/gerencial,
    // e tratam Segurança como indicador próprio (nunca misturado em "eficiência").
    var porTipo = horasPorTipoParada(lista);
    var totalOperacional = porTipo['Operacional']||0;
    var totalSeguranca = porTipo['Segurança']||0;
    var totalOutro = porTipo['Outro']||0;
    var numParadasSeguranca = contarParadasPorTipo(lista, 'Segurança');
    var horasDisponiveisTotal = Math.max(totalProgramada - totalManutencao - totalOperacional - totalOutro, 0);
    var disponibilidadeTotal = totalProgramada>0 ? (horasDisponiveisTotal/totalProgramada*100) : 0;
    var indicePerdaOperacional = totalProgramada>0 ? (totalOperacional/totalProgramada*100) : 0;

    return {
      totalProgramada: Math.round(totalProgramada*100)/100,
      totalHorimetro: totalHorimetro,
      totalManutencao: Math.round(totalManutencao*100)/100,
      totalParadaGeral: Math.round(totalParadaGeral*100)/100,
      numParadasManut: numParadasManut,
      dm: Math.round(dm*10)/10,
      ut: Math.round(Math.min(ut,999)*10)/10,
      oee: Math.round(Math.min(oee,999)*10)/10,
      mtbf: mtbf===null?null:Math.round(mtbf*10)/10,
      mttr: mttr===null?null:Math.round(mttr*10)/10,
      naoApontado: naoApontado,
      totalOperacional: Math.round(totalOperacional*100)/100,
      totalSeguranca: Math.round(totalSeguranca*100)/100,
      totalOutro: Math.round(totalOutro*100)/100,
      numParadasSeguranca: numParadasSeguranca,
      disponibilidadeTotal: Math.round(disponibilidadeTotal*10)/10,
      indicePerdaOperacional: Math.round(indicePerdaOperacional*10)/10
    };
  }

