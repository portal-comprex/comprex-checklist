  function medicaoFiltrarLista(){
    var cliente = document.getElementById('medCliente').value.trim();
    var ordemId = resolverOrdemFiltro('medOrdem');
    var equipId = resolverEquipFiltro('medEquip');
    var de = document.getElementById('medDe').value;
    var ate = document.getElementById('medAte').value;
    var ordensValidas = {};
    state.ordens.forEach(function(o){ if((!cliente||o.cliente===cliente) && (!ordemId||o.id===ordemId)) ordensValidas[o.id]=true; });
    return state.apropriacoes.filter(function(a){
      if(!ordensValidas[a.ordemId]) return false;
      if(equipId && a.equipamentoId!==equipId) return false;
      if(de && a.data<de) return false;
      if(ate && a.data>ate) return false;
      return true;
    });
  }

  function medicaoPorTarifa(lista){
    return state.tarifasHora.map(function(t){
      var lancamentos = lista.filter(function(a){ return a.ordemId===t.ordemId; });
      var horasEfetivas = lancamentos.reduce(function(s,a){ return s+horasEfetivasMedicao(a, t.baseCalculo); },0);
      var horasFaturadas = Math.max(horasEfetivas, t.horasMinimasMes||0);
      var valor = horasFaturadas * t.valorHora;
      return {tarifa:t, horasEfetivas:horasEfetivas, horasFaturadas:horasFaturadas, valor:valor};
    });
  }

  // Soma horas faturadas de uma tarifa por hora respeitando o mínimo mensal MÊS A MÊS
  // (não um único mínimo aplicado a um intervalo que pode abranger vários meses).
  function horasFaturadasPorMes(lancamentos, tarifa){
    var porMes = {};
    lancamentos.forEach(function(a){
      var chave = a.data.slice(0,7); // AAAA-MM
      if(!porMes[chave]) porMes[chave] = [];
      porMes[chave].push(a);
    });
    var total = 0;
    Object.keys(porMes).forEach(function(mes){
      var horas = porMes[mes].reduce(function(s,a){ return s+horasEfetivasMedicao(a, tarifa.baseCalculo); },0);
      total += Math.max(horas, tarifa.horasMinimasMes||0);
    });
    return total;
  }

