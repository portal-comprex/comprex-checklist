    ['dashDe','dashAte','dashCliente','dashOrdem','dashEquip','dashOperador'].forEach(function(id){ document.getElementById(id).value=''; });
    document.getElementById('dashDe').dispatchEvent(new Event('change'));
  });
  document.querySelectorAll('.dash-tab').forEach(function(tabBtn){
    tabBtn.addEventListener('click', function(){
      document.querySelectorAll('.dash-tab').forEach(function(b){ b.classList.toggle('active', b===tabBtn); });
      var alvo = tabBtn.getAttribute('data-dashtab');
      document.querySelectorAll('.dash-tab-content').forEach(function(c){ c.classList.toggle('active', c.getAttribute('data-dashtabcontent')===alvo); });
    });
  });
  document.getElementById('dashImprimirBtn').addEventListener('click', function(){ window.print(); });
  document.getElementById('topbarImprimirBtn').addEventListener('click', function(){ window.print(); });
  document.getElementById('dashExportPdfBtn').addEventListener('click', function(){
    toast('Use "Salvar como PDF" na janela de impressão que vai abrir.');
    window.print();
  });
  document.getElementById('dashExportExcelBtn').addEventListener('click', function(){
    var lista = dashboardApropriacoesFiltradas();
    var wb = XLSX.utils.book_new();
    var resumoAoa = [
      ['Resumo do Dashboard', '', ''],
      ['Equipamentos cadastrados', state.equipamentos.length],
      ['Horas de horímetro (período filtrado)', horimetroAgregado(lista)],
      ['Lançamentos no período filtrado', lista.length]
    ];
    XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(resumoAoa), 'Resumo');
    var porEquip = {};
    lista.forEach(function(a){ if(!porEquip[a.equipamentoId]) porEquip[a.equipamentoId]=[]; porEquip[a.equipamentoId].push(a); });
    var linhasEquip = Object.keys(porEquip).map(function(eid){
      var eq = getEquip(eid);
      return [eq?eq.codigo:'—', eq?eq.tipo:'—', horimetroDoEquipamento(porEquip[eid]), porEquip[eid].reduce(function(s,a){return s+a.horasOperador;},0)];
    });
    var equipAoa = [['Código','Tipo','H. Horímetro','H. Programada']].concat(linhasEquip);
    XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(equipAoa), 'Por Equipamento');
    XLSX.writeFile(wb, 'dashboard_comprex.xlsx');
  });
  document.getElementById('resetSampleBtn').addEventListener('click', function(){
    confirmModal('Redefinir para dados importados', 'Isso substitui todos os equipamentos, ordens e lançamentos atuais (visíveis a todos os usuários) pelo conjunto de dados importado da planilha de Junho/2026. Esta ação não pode ser desfeita.', async function(){
      state.equipamentos = JSON.parse(JSON.stringify(SEED_EQUIPAMENTOS));
      state.ordens = JSON.parse(JSON.stringify(SEED_ORDENS));
      state.apropriacoes = JSON.parse(JSON.stringify(SEED_APROPRIACOES));
      await saveList('equipamentos_v6', state.equipamentos);
      await saveList('ordens_v9', state.ordens);
      await saveList('apropriacoes_v7', state.apropriacoes);
      toast('Dados redefinidos para o exemplo.');
      renderAll();
    });
  });

  /* ============ INIT ============ */
  function applyPerfil(perfil){
    state.perfil = perfil;
    var labels = {campo:'Campo', escritorio:'Escritório', administrador:'Administrador'};
    var nomeTag = state.usuarioLogado ? ' · '+state.usuarioLogado.nome : '';
    document.getElementById('perfilLabel').textContent = 'Perfil: '+(labels[perfil]||perfil)+nomeTag;
    document.querySelectorAll('[data-role-only="controladoria"]').forEach(function(el){
      el.style.display = (perfil==='escritorio' || perfil==='administrador') ? '' : 'none';
    });
    document.querySelectorAll('[data-role-only="administrador"]').forEach(function(el){
      el.style.display = (perfil==='administrador') ? '' : 'none';
    });
    switchView(perfil === 'campo' ? 'apropriacao' : 'dashboard');
  }

  async function saveOperadorOrdem(ordemId){
    try{ localStorage.setItem('operador_ordem_atual', ordemId); }catch(e){}
    state.operadorOrdemId = ordemId;
  }
  async function loadOperadorOrdem(){
    try{ return localStorage.getItem('operador_ordem_atual') || null; }catch(e){ return null; }
  }

  function promptEscolherOrdem(onConfirm){
    var ordensOrdenadas = state.ordens.slice().sort(function(a,b){
      if(a.cliente!==b.cliente) return a.cliente.localeCompare(b.cliente,'pt-BR');
      return a.nome.localeCompare(b.nome,'pt-BR');
    });
    openModal(
      '<h3>Em qual ordem você está trabalhando?</h3>' +
      '<p style="font-size:13px;color:var(--text-muted);line-height:1.5;">Selecione a obra/ordem atual. Você só vai lançar e ver apropriações dessa ordem — se mudar de obra, use "Trocar ordem" no menu.</p>' +
      '<div class="field"><label>Ordem</label><div class="combo-wrap"><input type="text" id="escolherOrdemInput" autocomplete="off" placeholder="Digite ou selecione a ordem…"><div class="combo-list" id="escolherOrdemList"></div></div></div>' +
      '<div id="escolherOrdemError"></div>' +
      '<div class="modal-actions">' +
        '<button class="btn btn-primary" id="escolherOrdemOk">Confirmar</button>' +
      '</div>'
    );
    wireComboBox('escolherOrdemInput', 'escolherOrdemList', function(){ return ordensOrdenadas.map(function(o){ return ordemLabel(o); }); }, ordensOrdenadas.map(function(o){ return o.cliente; }));
    document.getElementById('escolherOrdemOk').onclick = function(){
      var texto = document.getElementById('escolherOrdemInput').value.trim();
      var ordemObj = ordensOrdenadas.filter(function(o){ return ordemLabel(o)===texto; })[0];
      if(!ordemObj){
        document.getElementById('escolherOrdemError').innerHTML = '<div class="form-error">Ordem não reconhecida — digite ou selecione uma da lista.</div>';
        return;
      }
      closeModal();
      onConfirm(ordemObj.id);
    };
  }


  async function doLogin(){
    var usuario = document.getElementById('loginUsuario').value.trim().toLowerCase();
    var senha = document.getElementById('loginSenha').value.trim();
    var errBox = document.getElementById('loginError');
    errBox.innerHTML = '';
    if(typeof supabaseClient === 'undefined' || !supabaseClient){
      errBox.innerHTML = '<div class="form-error">Não foi possível conectar ao banco de dados (Supabase). Verifique sua internet e recarregue a página.</div>';
      return;
    }
    // Contas simples (admin/campo/escritorio) sem "@" viram e-mail no domínio interno do SISPOC,
    // já que o Supabase Auth exige um e-mail para login por senha.
    var email = usuario.indexOf('@')>-1 ? usuario : usuario+'@sispoc.local';
    var loginBtnEl = document.getElementById('loginBtn');
    loginBtnEl.disabled = true;
    var resultado;
    try{
      resultado = await supabaseClient.auth.signInWithPassword({email: email, password: senha});
    }catch(erroDeConexao){
      loginBtnEl.disabled = false;
      console.error('Erro de conexão no login:', erroDeConexao);
      errBox.innerHTML = '<div class="form-error">Erro de conexão com o servidor. Veja o Console (F12) para detalhes.</div>';
      return;
    }
    loginBtnEl.disabled = false;
    if(resultado.error){
      console.error('Erro de login retornado pelo Supabase:', resultado.error);
      errBox.innerHTML = '<div class="form-error">Usuário ou senha inválidos. ('+esc(resultado.error.message||'')+')</div>';
      return;
    }
    var meta = resultado.data.user.user_metadata || {};
    var perfilNivel = (meta.nivel || 'CAMPO').toUpperCase();
    var perfil = perfilNivel==='CAMPO' ? 'campo' : perfilNivel==='ESCRITORIO' ? 'escritorio' : 'administrador';
    var match = {id: resultado.data.user.id, nome: meta.nome || usuario, login: email, nivel: perfilNivel, status: 'Ativo'};
    function entrar(){
      state.usuarioLogado = match;
      document.getElementById('profileScreen').style.display = 'none';
      document.getElementById('app').style.display = 'flex';
      applyPerfil(perfil);
    }
    if(perfil==='campo'){
      promptEscolherOrdem(async function(ordemId){
        await saveOperadorOrdem(ordemId);
        await savePerfil(perfil);
        await saveUsuarioLogadoId(match.id);
        entrar();
      });
    } else {
      savePerfil(perfil);
      saveUsuarioLogadoId(match.id);
      entrar();
    }
  }
  document.getElementById('loginBtn').addEventListener('click', doLogin);
  document.getElementById('loginSenha').addEventListener('keydown', function(e){ if(e.key==='Enter') doLogin(); });
  document.getElementById('trocarPerfilBtn').addEventListener('click', async function(){
    await supabaseClient.auth.signOut();
    document.getElementById('app').style.display = 'none';
    document.getElementById('profileScreen').style.display = 'flex';
    document.getElementById('loginUsuario').value = '';
    document.getElementById('loginSenha').value = '';
  });
  document.getElementById('sairSistemaBtn').addEventListener('click', async function(){
    await supabaseClient.auth.signOut();
    document.getElementById('app').style.display = 'none';
    document.getElementById('profileScreen').style.display = 'flex';
    document.getElementById('loginUsuario').value = '';
    document.getElementById('loginSenha').value = '';
    toast('Você saiu do sistema.');
  });
  document.addEventListener('click', function(e){
    if(state.perfil !== 'escritorio') return;
    var btn = e.target.closest('button');
    if(!btn) return;
    var bloqueados = ['novoEquipamentoBtn','novaOrdemBtn','novoOperadorBtn','novaTarifaProducaoBtn','novaTarifaVerbaBtn','novaTarifaHoraBtn','novoMotivoParadaBtn','novaEscalaBtn','novoUsuarioBtn'];
    var attrs = btn.getAttributeNames();
    var isCrud = attrs.some(function(a){ return a.indexOf('data-edit-')===0 || a.indexOf('data-del-')===0; }) || bloqueados.indexOf(btn.id)>-1;
    if(isCrud){
      e.preventDefault(); e.stopPropagation(); e.stopImmediatePropagation();
      toast('Seu perfil (Escritório) tem acesso de visualização — não permite alterações no sistema.');
    }
  }, true);

  async function init(){
    document.getElementById('todayLabel').textContent = new Date().toLocaleDateString('pt-BR', {weekday:'long', year:'numeric', month:'long', day:'numeric'});
    var erroCarregamento = false;
    var eq = await loadList('equipamentos_v6');
    var ord = await loadList('ordens_v9');
    var ap = await loadList('apropriacoes_v7');
    var oper = await loadList('operadores_v4');
    var tarH = await loadList('tarifas_hora_v2');
    var tarP = await loadList('tarifas_producao_v3');
    var tarV = await loadList('tarifas_verba_v1');
    var motParada = await loadList('motivos_parada_v1');
    var escalas = await loadList('escalas_v1');
    var usuarios = await loadList('usuarios_v1');
    var producoes = await loadList('producoes_v1');
    var cli = await loadList('clientes_v2');
    var cliNum = await loadList('cliente_numeros_v3');
    var matPesagem = await loadList('materiais_pesagem_v1');
    var servHora = await loadList('servicos_hora_v1');
    var servVerba = await loadList('servicos_verba_v1');
    if(eq===null){ eq = JSON.parse(JSON.stringify(SEED_EQUIPAMENTOS)); erroCarregamento = true; }
    if(ord===null){ ord = JSON.parse(JSON.stringify(SEED_ORDENS)); erroCarregamento = true; }
    if(ap===null){ ap = JSON.parse(JSON.stringify(SEED_APROPRIACOES)); erroCarregamento = true; }
    if(oper===null){ oper = JSON.parse(JSON.stringify(SEED_OPERADORES)); erroCarregamento = true; }
    if(tarH===null){ tarH = JSON.parse(JSON.stringify(SEED_TARIFAS_HORA)); erroCarregamento = true; }
    if(tarP===null){ tarP = JSON.parse(JSON.stringify(SEED_TARIFAS_PRODUCAO)); erroCarregamento = true; }
    if(tarV===null){ tarV = []; await saveList('tarifas_verba_v1', tarV); }
    if(motParada===null){ motParada = JSON.parse(JSON.stringify(SEED_MOTIVOS_PARADA)); erroCarregamento = true; }
    else {
      var motParadaSemOutro = motParada.filter(function(m){ return m.descricao!=='Outro'; });
      if(motParadaSemOutro.length !== motParada.length){ motParada = motParadaSemOutro; await saveList('motivos_parada_v1', motParada); }
    }
    if(escalas===null){ escalas = JSON.parse(JSON.stringify(SEED_ESCALAS)); erroCarregamento = true; }
    if(usuarios===null){ usuarios = JSON.parse(JSON.stringify(SEED_USUARIOS)); erroCarregamento = true; }
    if(producoes===null){ producoes = []; await saveList('producoes_v1', producoes); }
    var logAud = await loadList('log_auditoria_v1');
    if(logAud===null){ logAud = []; await saveList('log_auditoria_v1', logAud); }
    if(cli===null){ cli = SEED_CLIENTES.slice(); erroCarregamento = true; }
    if(cliNum===null){ cliNum = Object.assign({}, SEED_CLIENTE_NUMEROS); erroCarregamento = true; }
    if(matPesagem===null){ matPesagem = SEED_MATERIAIS_PESAGEM.slice(); await saveList('materiais_pesagem_v1', matPesagem); }
    if(servHora===null){ servHora = SEED_SERVICOS_HORA.slice(); await saveList('servicos_hora_v1', servHora); }
    if(servVerba===null){ servVerba = SEED_SERVICOS_VERBA.slice(); await saveList('servicos_verba_v1', servVerba); }
    state.equipamentos = eq; state.ordens = ord; state.apropriacoes = ap; state.operadores = oper; state.tarifasHora = tarH; state.tarifasProducao = tarP; state.tarifasVerba = tarV; state.motivosParada = motParada; state.escalas = escalas; state.usuarios = usuarios; state.logAuditoria = logAud; state.producoes = producoes;
    CLIENTES = cli.slice().sort(function(a,b){ return a.localeCompare(b,'pt-BR'); });
    CLIENTE_NUMEROS = cliNum;
    MATERIAIS_PESAGEM = matPesagem.slice().sort(function(a,b){ return a.localeCompare(b,'pt-BR'); });
    SERVICOS_HORA = servHora.slice().sort(function(a,b){ return a.localeCompare(b,'pt-BR'); });
    SERVICOS_VERBA = servVerba.slice().sort(function(a,b){ return a.localeCompare(b,'pt-BR'); });
    document.getElementById('loadingScreen').style.display = 'none';
    if(erroCarregamento){
      var avisoErro = document.createElement('div');
      avisoErro.style.cssText = 'position:fixed;top:0;left:0;right:0;z-index:999;background:#B42318;color:#fff;padding:12px 20px;text-align:center;font-weight:700;font-size:13px;';
      avisoErro.textContent = '⚠ Não foi possível carregar alguns dados do servidor agora. Para sua segurança, NADA foi salvo/sobrescrito — tente recarregar a página (F5). Se persistir, avise a Nalva/TI antes de continuar usando o sistema.';
      document.body.appendChild(avisoErro);
    }

    var usuarioAutenticado = null, perfil = null;
    try{
      var sessaoAtual = await supabaseClient.auth.getSession();
      usuarioAutenticado = sessaoAtual.data && sessaoAtual.data.session ? sessaoAtual.data.session.user : null;
      perfil = usuarioAutenticado ? await loadPerfil() : null;
    }catch(erroSessao){
      console.error('Erro ao verificar sessão do Supabase:', erroSessao);
    }

    if(!perfil || !usuarioAutenticado){
      document.getElementById('profileScreen').style.display = 'flex';
      renderAll();
      return;
    }
    var metaAtual = usuarioAutenticado.user_metadata || {};
    state.usuarioLogado = {id: usuarioAutenticado.id, nome: metaAtual.nome || usuarioAutenticado.email, login: usuarioAutenticado.email, nivel: (metaAtual.nivel||'CAMPO').toUpperCase(), status:'Ativo'};
    if(perfil === 'campo'){
      state.operadorOrdemId = await loadOperadorOrdem();
    }
    document.getElementById('app').style.display = 'flex';
    applyPerfil(perfil);
    renderAll();
  }
  init();

})();
</script>
</body>
</html>
