  var chartInstances = {};
  function truncLabel(s, n){ s=String(s); return s.length>n ? s.slice(0,n-1)+'…' : s; }

  // Gráfico de barras horizontais em SVG puro — sem dependência externa.
  function svgBarChartHtml(entries, color, valueFmt){
    if(!entries || entries.length===0) return '<div class="empty-state" style="padding:20px;">Sem dados para exibir.</div>';
    valueFmt = valueFmt || function(v){ return brNum(v,1); };
    var max = Math.max.apply(null, entries.map(function(e){ return e.value; })) || 1;
    var rowH = 24, gap = 8, leftW = 130, chartW = 300, rightW = 70;
    var totalW = leftW + chartW + rightW;
    var totalH = entries.length*(rowH+gap);
    var rows = entries.map(function(e, i){
      var y = i*(rowH+gap);
      var barW = Math.max((e.value/max)*chartW, 2);
      return '<g>' +
        '<text x="'+(leftW-8)+'" y="'+(y+rowH*0.68)+'" font-size="11.5" fill="#5C6B78" font-family="Arial" text-anchor="end">'+esc(truncLabel(e.label,18))+'</text>' +
        '<rect x="'+leftW+'" y="'+y+'" width="'+barW+'" height="'+rowH+'" rx="4" fill="'+color+'"><title>'+esc(e.label)+': '+esc(valueFmt(e.value))+'</title></rect>' +
        '<text x="'+(leftW+barW+8)+'" y="'+(y+rowH*0.68)+'" font-size="11.5" fill="#16232F" font-family="ui-monospace,monospace">'+esc(valueFmt(e.value))+'</text>' +
      '</g>';
    }).join('');
    return '<svg viewBox="0 0 '+totalW+' '+totalH+'" width="100%" height="100%" preserveAspectRatio="xMinYMin meet">'+rows+'</svg>';
  }

