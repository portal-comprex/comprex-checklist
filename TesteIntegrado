  /* ============ APROPRIAÇÃO FORM ============ */
  function paradaHoras(p){
    var h = diffHoras(p.inicio, p.termino);
    return h===null ? 0 : Math.round(h*100)/100;
  }
  function tipoServicoOptions(selected){
    return TIPOS_SERVICO_MANUTENCAO_GRUPOS.map(function(g){
      return '<optgroup label="'+esc(g.grupo)+'">'+g.itens.map(function(item){
        return '<option value="'+esc(item)+'"'+(item===selected?' selected':'')+'>'+esc(item)+'</option>';
      }).join('')+'</optgroup>';
    }).join('');
  }

