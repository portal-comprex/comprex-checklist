<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>POC — Painel Operacional Comprex</title>
<style>
  :root{
    --navy:#1B2A4A;
    --navy-deep:#0F1B33;
    --navy-mid:#1F3A5F;
    --blue:#2E75B6;
    --blue-soft:#E7F0F9;
    --orange:#E8833A;
    --orange-deep:#C4661F;
    --yellow:#FFC000;
    --yellow-deep:#A67900;
    --bg:#EEF2F6;
    --surface:#FFFFFF;
    --border:#DCE3EA;
    --text:#16232F;
    --text-muted:#5C6B78;
    --st-obra:#2E75B6;
    --st-disp:#2E9E5B;
    --st-manut:#E0972A;
    --st-manutt:#A6672A;
    --st-venda:#7C5CBF;
    --st-inativo:#8A98A5;
    --st-inoperante:#A83232;
    --st-sucateada:#5C4A3D;
    --danger:#B23B3B;
    --radius:10px;
    --font-display: "Arial Narrow","Helvetica Neue Condensed",Arial,sans-serif;
    --font-body:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
    --font-mono:ui-monospace,"SFMono-Regular",Consolas,"Liberation Mono",Menlo,monospace;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;height:100%;}
  body{
    font-family:var(--font-body);
    background:var(--bg);
    color:var(--text);
    -webkit-font-smoothing:antialiased;
  }
  @media (prefers-reduced-motion: no-preference){
    .card, .btn, .nav-item, .modal-overlay, .toast{ transition: all .15s ease; }
  }
  a{color:inherit;}
  button{font-family:inherit;cursor:pointer;}
  :focus-visible{outline:2px solid var(--orange);outline-offset:2px;}

  #app{display:flex;min-height:100vh;}

  /* ---------- Sidebar ---------- */
  .sidebar{
    width:230px;flex-shrink:0;
    background:
      repeating-linear-gradient(115deg, rgba(232,131,58,0.05) 0 2px, transparent 2px 34px),
      linear-gradient(180deg,var(--navy) 0%, var(--navy-deep) 100%);
    color:#fff;
    display:flex;flex-direction:column;
    position:sticky;top:0;height:100vh;
  }
  .brand{padding:24px 20px 16px 20px;}
  .brand-logo-img{max-width:100%;height:auto;display:block;}
  .brand-sub{font-size:11px;color:var(--orange);letter-spacing:0.08em;margin-top:7px;text-transform:uppercase;font-weight:700;}
  .hazard{
    height:14px;
    background:
      linear-gradient(120deg, transparent 42%, rgba(255,255,255,0.35) 42%, rgba(255,255,255,0.35) 48%, transparent 48%),
      linear-gradient(120deg, transparent 58%, rgba(255,255,255,0.35) 58%, rgba(255,255,255,0.35) 64%, transparent 64%),
      linear-gradient(90deg, var(--navy-mid), var(--orange));
    background-size:200% 100%, 200% 100%, 100% 100%;
  }
  .nav{padding:14px 10px;flex:1;display:flex;flex-direction:column;}
  .nav-item{
    display:flex;align-items:center;gap:10px;width:100%;text-align:left;
    background:transparent;border:none;color:#D7E4F1;
    padding:11px 12px;margin-bottom:4px;border-radius:8px;
    font-size:14px;font-weight:600;letter-spacing:0.01em;border-left:3px solid transparent;
  }
  .nav-item svg{flex-shrink:0;}
  .nav-item:hover{background:rgba(255,255,255,0.06);color:#fff;}
  .nav-item.active{background:rgba(232,131,58,0.14);color:#fff;border-left:3px solid var(--orange);}
  .nav-item-sair{margin-top:auto;color:#F3B99A;border-top:1px solid rgba(255,255,255,0.08);border-radius:0;padding-top:14px;}
  .nav-item-sair:hover{background:rgba(215,79,35,0.16);color:#fff;}
  .sidebar-footer{padding:14px 16px 18px 16px;font-size:11px;color:#8DA3B8;line-height:1.5;border-top:1px solid rgba(255,255,255,0.08);}
  .reset-link{background:none;border:none;color:#B9CBDB;text-decoration:underline;font-size:11px;padding:0;margin-top:8px;display:inline-block;}
  .reset-link:hover{color:#fff;}

  /* ---------- Main ---------- */
  .main{flex:1;min-width:0;display:flex;flex-direction:column;}
  .topbar{
    background:var(--surface);border-bottom:1px solid var(--border);padding:18px 28px;
    display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:6px;
  }
  .topbar h1{font-family:var(--font-display);text-transform:uppercase;letter-spacing:0.03em;font-size:21px;margin:0;}
  .topbar .desc{font-size:12.5px;color:var(--text-muted);margin-top:2px;}
  .topbar .today{font-size:12px;color:var(--text-muted);font-family:var(--font-mono);}

  .view{display:none;padding:24px 28px 60px 28px;}
  .view.active{display:block;}

  .section-title{
    font-family:var(--font-display);text-transform:uppercase;letter-spacing:0.04em;
    font-size:13px;color:var(--navy);margin:4px 0 10px 0;font-weight:700;
  }
  .cadastro-hero{
    position:relative;overflow:hidden;border-radius:14px;margin-bottom:22px;padding:26px 28px;
    background:linear-gradient(120deg, var(--navy-deep) 0%, var(--navy) 55%, var(--navy-mid) 100%);
    color:#fff;
  }
  .cadastro-hero-glow{position:absolute;right:-40px;top:-40px;width:180px;height:180px;border-radius:50%;background:radial-gradient(circle, rgba(232,131,58,0.35), transparent 70%);}
  .cadastro-hero-eyebrow{font-family:var(--font-display);text-transform:uppercase;letter-spacing:0.12em;font-size:12px;color:var(--orange);font-weight:700;}
  .cadastro-hero-title{font-family:var(--font-display);text-transform:uppercase;letter-spacing:0.02em;font-size:26px;margin:4px 0 8px 0;font-weight:700;}
  .cadastro-hero-sub{font-size:13.5px;color:#C7D6E5;max-width:75%;line-height:1.5;}
  @media (max-width:820px){ .cadastro-hero-sub{max-width:100%;} }
  .cadastro-cards-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px;}
  .cadastro-card{
    background:#fff;border:1px solid var(--border);border-top:3px solid var(--orange);border-radius:12px;
    padding:18px 20px;cursor:pointer;box-shadow:0 1px 4px rgba(16,35,63,0.06);
    transition:box-shadow .15s ease, transform .15s ease;
  }
  .cadastro-card:hover{box-shadow:0 6px 16px rgba(16,35,63,0.12);transform:translateY(-2px);}
  .cadastro-card-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;}
  .cadastro-card-icon{width:38px;height:38px;border-radius:8px;background:var(--navy-deep);color:#fff;display:flex;align-items:center;justify-content:center;}
  .cadastro-card-count{font-family:var(--font-mono);font-size:22px;font-weight:700;color:var(--navy);}
  .cadastro-card-title{font-family:var(--font-display);text-transform:uppercase;letter-spacing:0.02em;font-size:15px;color:var(--text);font-weight:700;margin-bottom:6px;}
  .cadastro-card-desc{font-size:12.5px;color:var(--text-muted);line-height:1.5;margin-bottom:12px;min-height:52px;}
  .cadastro-card-link{font-family:var(--font-display);text-transform:uppercase;letter-spacing:0.03em;font-size:11.5px;color:var(--orange);font-weight:700;}

  .dash-tab-content{display:none;}
  .dash-tab-content.active{display:block;}
  .dash-tabbar-row{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;margin-bottom:16px;}
  .dash-tabbar{display:flex;gap:6px;flex-wrap:wrap;background:#EEF1F4;padding:4px;border-radius:24px;}
  .dash-tab{border:none;background:transparent;padding:8px 16px;border-radius:20px;font-size:13px;font-weight:700;color:var(--text-muted);cursor:pointer;}
  .dash-tab.active{background:var(--navy-deep);color:#fff;}
  .dash-tab:not(.active):hover{color:var(--text);}
  .dash-filters-panel{border:1px solid #C9DCEF;background:#F5F9FD;border-radius:12px;padding:16px 18px;margin-bottom:20px;}
  .dash-filters-header{display:flex;justify-content:space-between;align-items:center;font-size:12px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:12px;}
  .dash-filters-row{display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end;margin-bottom:10px;}
  .dash-filters-row .field{min-width:150px;flex:1;}
  .dash-filters-row .field label{font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;}
  .rapido-badge{background:var(--orange);color:#fff;font-size:10.5px;font-weight:700;padding:6px 10px;border-radius:6px;align-self:center;}
  .dash-filters-status{font-size:12px;color:var(--text-muted);border-top:1px solid #DCE7F2;padding-top:10px;}

  .dash-hero{
    position:relative;overflow:hidden;border-radius:14px;margin-bottom:26px;padding:26px 28px;
    background:linear-gradient(120deg, var(--navy-deep) 0%, var(--navy) 55%, var(--navy-mid) 100%);
    color:#fff;
  }
  .dash-hero-chevrons{position:absolute;right:22px;top:50%;transform:translateY(-50%);display:flex;gap:6px;opacity:0.9;}
  .dash-hero-chevrons span{display:inline-block;width:0;height:0;border-top:22px solid transparent;border-bottom:22px solid transparent;border-left:26px solid #8A98A5;}
  .dash-hero-chevrons span:nth-child(2){border-left-color:#B2BEC7;margin-left:-14px;}
  .dash-hero-chevrons span:nth-child(3){border-left-color:#D8DEE3;margin-left:-14px;}
  .dash-hero-eyebrow{font-family:var(--font-display);text-transform:uppercase;letter-spacing:0.12em;font-size:12px;color:var(--orange);font-weight:700;}
  .dash-hero-title{font-family:var(--font-display);text-transform:uppercase;letter-spacing:0.02em;font-size:28px;margin:4px 0 8px 0;font-weight:700;}
  .dash-hero-sub{font-size:13.5px;color:#C7D6E5;max-width:70%;}
  @media (max-width:820px){ .dash-hero-chevrons{display:none;} .dash-hero-sub{max-width:100%;} }

  .dash-group{margin-bottom:28px;}
  .dash-group-header{
    display:flex;align-items:center;gap:10px;margin:0 0 14px 0;padding-bottom:8px;
    border-bottom:2px solid var(--navy);
  }
  .dash-group-header .num{
    font-family:var(--font-mono);font-size:11px;font-weight:700;color:#fff;background:var(--navy);
    width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;
  }
  .dash-group-header h2{
    font-family:var(--font-display);text-transform:uppercase;letter-spacing:0.04em;
    font-size:15px;color:var(--navy);margin:0;font-weight:700;
  }
  .dash-group-header .dash-group-desc{font-size:11.5px;color:var(--text-muted);margin-left:auto;font-weight:400;}

  /* ---------- Sub tabs ---------- */
  .subtabs{display:flex;gap:8px;margin-bottom:16px;}
  .subtab-btn{padding:7px 15px;border-radius:20px;border:1px solid var(--border);background:#fff;font-size:12.5px;font-weight:700;color:var(--text-muted);}
  .subtab-btn.active{background:var(--navy);color:#fff;border-color:var(--navy);}
  .subview{display:none;}
  .subview.active{display:block;}

  /* ---------- Cards / KPIs ---------- */
  .kpi-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin-bottom:20px;}
  .kpi-card{position:relative;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:18px 16px 14px 16px;box-shadow:0 1px 3px rgba(16,35,63,0.06);transition:box-shadow .15s ease, transform .15s ease;overflow:hidden;}
  .kpi-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg, var(--orange), var(--navy-mid));}
  .kpi-card:hover{box-shadow:0 4px 14px rgba(16,35,63,0.10);transform:translateY(-1px);}
  .kpi-label{font-family:var(--font-display);text-transform:uppercase;letter-spacing:0.05em;font-size:11.5px;color:var(--text-muted);font-weight:700;}
  .kpi-value{font-family:var(--font-mono);font-size:30px;font-weight:700;margin-top:5px;color:var(--navy);letter-spacing:-0.01em;}
  .kpi-gauge{margin-top:10px;height:6px;border-radius:4px;background:#E7ECF1;position:relative;overflow:hidden;}
  .kpi-gauge-fill{height:100%;border-radius:4px;}
  .kpi-ticks{display:flex;justify-content:space-between;margin-top:3px;}
  .kpi-ticks span{width:1px;height:4px;background:#C7D2DB;}

  .grid-2{display:grid;grid-template-columns:1.1fr 1fr;gap:16px;margin-bottom:20px;}
  @media (max-width:900px){.grid-2{grid-template-columns:1fr;}}
  .grid-3{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;}
  .grid-manut{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:14px;}
  .manut-card{border:1px solid var(--border);border-radius:10px;padding:14px 16px;background:#fff;}
  .manut-card-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:4px;}
  .manut-card-title{font-family:var(--font-display);text-transform:uppercase;letter-spacing:0.02em;font-size:12px;font-weight:700;color:var(--text);}
  .manut-card-count{font-family:var(--font-mono);font-size:20px;font-weight:700;color:var(--danger);}
  .manut-card-count.zero{color:var(--text-muted);}
  .manut-card-desc{font-size:12px;color:var(--text-muted);line-height:1.4;margin-bottom:10px;min-height:32px;}
  .manut-card button{width:100%;background:#fff;border:1px solid var(--danger);color:var(--danger);border-radius:8px;padding:7px;font-weight:700;font-size:13px;}
  .manut-card button:not(:disabled):hover{background:#FBEDED;}
  .manut-card button:disabled{border-color:var(--border);color:var(--text-muted);cursor:not-allowed;}
  .nivel-card{border:1px solid var(--border);border-radius:10px;padding:14px 16px;background:#FAFBFC;}
  .nivel-card-title{font-family:var(--font-display);text-transform:uppercase;letter-spacing:0.03em;font-size:13px;font-weight:700;color:var(--navy);margin-bottom:6px;}
  .nivel-card-desc{font-size:12.5px;color:var(--text-muted);line-height:1.5;}
  .nivel-badge{display:inline-flex;align-items:center;padding:3px 10px;border-radius:20px;font-size:11.5px;font-weight:700;text-transform:uppercase;letter-spacing:0.02em;}
  .nivel-badge.campo{background:#EEF1F4;color:#5C6B78;}
  .nivel-badge.escritorio{background:#FFE8D3;color:#B25E17;}
  .nivel-badge.administrador{background:var(--navy-deep);color:#fff;}

  .card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:18px 18px 16px 18px;box-shadow:0 1px 4px rgba(16,35,63,0.06);}
  .card h2{font-family:var(--font-display);text-transform:uppercase;letter-spacing:0.03em;font-size:14.5px;margin:0 0 14px 0;color:var(--navy);}

  /* ---------- Nameplate / status ---------- */
  .plate{display:inline-block;font-family:var(--font-mono);font-size:12.5px;font-weight:600;background:var(--navy-deep);color:#F5C989;padding:3px 8px;border-radius:4px;letter-spacing:0.02em;white-space:nowrap;}
  .led{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;flex-shrink:0;}
  .status-badge{display:inline-flex;align-items:center;font-size:12.5px;font-weight:600;padding:4px 9px;border-radius:20px;background:#F2F5F8;}
  .muted-tag{font-size:12px;color:var(--text-muted);}

  /* ---------- Tables ---------- */
  .table-wrap{overflow-x:auto;}
  table{width:100%;border-collapse:collapse;font-size:13px;}
  thead th{text-align:left;font-family:var(--font-display);text-transform:uppercase;letter-spacing:0.03em;font-size:11px;color:var(--text-muted);border-bottom:2px solid var(--border);padding:8px 10px;white-space:nowrap;}
  tbody td{padding:9px 10px;border-bottom:1px solid var(--border);vertical-align:middle;}
  tbody tr:hover{background:#F7FAFC;}
  tbody tr:last-child td{border-bottom:none;}
  td.num, th.num{text-align:right;font-family:var(--font-mono);}
  .empty-row td{text-align:center;color:var(--text-muted);padding:26px 10px;font-size:13px;}

  /* Boletim de Medição — visual de formulário oficial, com bordas em todas as células */
  #bmConteudo table{border:1px solid var(--navy);}
  #bmConteudo thead th{border:1px solid var(--navy);background:var(--navy);color:#fff;text-transform:none;font-size:12px;letter-spacing:0;}
  #bmConteudo tbody td{border:1px solid var(--border);}
  #bmConteudo .card h2{border-bottom:2px solid var(--orange);padding-bottom:6px;margin-bottom:10px;}
  #bmDescontosResultado table{border:1px solid var(--navy);}
  #bmDescontosResultado td{border:1px solid var(--border);padding:6px 10px;}

  /* ---------- Forms / toolbar ---------- */
  .toolbar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-bottom:14px;justify-content:space-between;}
  .filters{display:flex;flex-wrap:wrap;gap:8px;align-items:flex-end;}
  .filters .field{margin-bottom:0;}
  .combo-item-all{font-style:italic;color:var(--text-muted);border-bottom:1px solid var(--border);}
  select, input[type=text], input[type=date], input[type=month], input[type=number], input[type=time], textarea{
    font-family:inherit;font-size:13px;padding:7px 9px;border:1px solid var(--border);border-radius:7px;background:#fff;color:var(--text);
  }
  select:focus, input:focus, textarea:focus{border-color:var(--blue);}
  label{font-size:12px;color:var(--text-muted);font-weight:600;display:block;margin-bottom:4px;}
  .field{margin-bottom:12px;}
  .field-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
  .field-row-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;}
  .field-row-ordem{display:grid;grid-template-columns:130px 1fr;gap:12px;}
  @media (max-width:560px){.field-row-ordem{grid-template-columns:1fr;}}
  .form-section input[type=text], .form-section input[type=date], .form-section input[type=number], .form-section input[type=time], .form-section select, .form-section textarea{width:100%;}
  .form-section .field{margin-bottom:22px;}
  .form-section .field-row, .form-section .field-row-ordem{margin-bottom:22px;}
  .form-section .field-row .field, .form-section .field-row-ordem .field{margin-bottom:0;}
  @media (max-width:560px){.field-row,.field-row-3{grid-template-columns:1fr;}}

  .btn{border-radius:8px;padding:8px 14px;font-size:13px;font-weight:700;border:1px solid transparent;display:inline-flex;align-items:center;gap:6px;}
  .btn-primary{background:linear-gradient(135deg, var(--orange), var(--orange-deep));color:#fff;box-shadow:0 2px 8px rgba(196,102,31,0.35);}
  .btn-primary:hover{background:linear-gradient(135deg, var(--orange-deep), var(--orange-deep));box-shadow:0 3px 10px rgba(196,102,31,0.45);transform:translateY(-1px);}
  .btn-outline{background:#fff;border-color:var(--border);color:var(--navy);}
  .btn-outline:hover{border-color:var(--blue);}
  .btn-ghost{background:#fff;color:var(--blue);padding:5px 12px;border:1px solid var(--blue);border-radius:20px;font-weight:600;}
  .btn-ghost:hover{background:var(--blue-soft);}
  .btn-back{display:inline-flex;align-items:center;gap:6px;background:var(--blue-soft);color:var(--blue);border:1px solid transparent;border-radius:20px;padding:7px 16px 7px 12px;font-weight:600;font-size:13px;margin-bottom:16px;cursor:pointer;transition:background .15s,border-color .15s,transform .15s;}
  .btn-back svg{transition:transform .15s;}
  .btn-back:hover{background:#fff;border-color:var(--blue);}
  .btn-back:hover svg{transform:translateX(-3px);}
  .btn-back:active{transform:scale(.97);}
  .btn-danger-ghost{background:#fff;color:var(--danger);padding:5px 12px;border:1px solid var(--danger);border-radius:20px;font-weight:600;}
  .btn-danger-ghost:hover{background:#FBEDED;}
  .btn-sm{padding:5px 9px;font-size:12px;}

  /* ---------- Charts ---------- */
  .legend{display:flex;flex-direction:column;gap:8px;margin-top:6px;}
  .legend-item{display:flex;align-items:center;gap:8px;font-size:12.5px;}
  .legend-item .n{margin-left:auto;font-family:var(--font-mono);color:var(--text-muted);}
  .bar-row{display:flex;align-items:center;gap:10px;margin-bottom:10px;font-size:12.5px;}
  .bar-label{width:160px;flex-shrink:0;color:var(--text-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .bar-track{flex:1;height:14px;background:#EEF2F6;border-radius:4px;overflow:hidden;}
  .bar-fill{height:100%;background:var(--blue);border-radius:4px;}
  .bar-val{width:50px;text-align:right;font-family:var(--font-mono);color:var(--text);}

  /* ---------- Paradas rows (form) ---------- */
  .parada-row{display:flex;gap:8px;align-items:center;margin-bottom:8px;}
  .parada-row select{flex:1;}
  .parada-row input[type=time]{width:90px;}
  .parada-row .parada-horas{width:50px;text-align:right;font-family:var(--font-mono);font-size:12.5px;color:var(--text);flex:none;}
  .parada-block{margin-bottom:4px;padding-bottom:8px;border-bottom:1px dashed var(--border);}
  .parada-block:last-child{border-bottom:none;}
  .parada-block .parada-row{margin-bottom:6px;}
  .parada-servico-wrap{padding-left:2px;margin-bottom:4px;}
  .parada-servico-wrap select{font-size:12.5px;color:var(--text-muted);}
  .combo-wrap{position:relative;}
  .combo-list{display:none;position:absolute;top:100%;left:0;right:0;background:#fff;border:1px solid var(--border);border-radius:8px;max-height:230px;overflow-y:auto;z-index:40;box-shadow:0 8px 20px rgba(0,0,0,0.14);margin-top:4px;}
  .combo-list.open{display:block;}
  .combo-group{padding:6px 10px 3px 10px;font-family:var(--font-display);text-transform:uppercase;letter-spacing:0.03em;font-size:10.5px;color:var(--text-muted);background:#F7FAFC;position:sticky;top:0;}
  .combo-item{padding:7px 10px;font-size:13px;cursor:pointer;}
  .combo-item:hover,.combo-item.active{background:var(--blue-soft);}
  .combo-empty{padding:9px 10px;font-size:12.5px;color:var(--text-muted);}
  .parada-remove{color:var(--danger);background:none;border:none;font-size:18px;line-height:1;padding:0 4px;flex:none;width:22px;}
  .add-parada-btn{font-size:12.5px;background:none;border:1px dashed var(--border);border-radius:7px;padding:6px 10px;color:var(--blue);width:100%;text-align:center;}

  /* ---------- Form sections (apropriação) ---------- */
  .form-section{border-radius:10px;padding:14px 16px 8px 16px;margin-bottom:16px;border:1px solid transparent;}
  .form-section-title{
    font-family:var(--font-display);text-transform:uppercase;letter-spacing:0.04em;
    font-size:11.5px;font-weight:700;margin-bottom:12px;display:flex;align-items:center;gap:7px;
  }
  .form-section-title .dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}
  .form-section-ident{background:#EFF5FB;border-color:#D7E7F5;}
  .form-section-ident .form-section-title{color:var(--navy);}
  .form-section-ident .dot{background:var(--blue);}
  .form-section-operador{background:#FFF9EC;border-color:#F3E4B8;}
  .form-section-operador .form-section-title{color:#8A6A0E;}
  .form-section-operador .dot{background:var(--yellow);}
  .form-section-equip{background:#F0F8F2;border-color:#D6ECDA;}
  .form-section-equip .form-section-title{color:#2A7A4B;}
  .form-section-equip .dot{background:var(--st-disp);}
  .form-section-paradas{background:#FDF3EA;border-color:#F2D9BE;}
  .form-section-paradas .form-section-title{color:#9A5B12;}
  .form-section-paradas .dot{background:var(--st-manut);}
  .field-row-timeline{display:grid;grid-template-columns:1fr 1.1fr 1fr 1.1fr 1fr;gap:10px;align-items:end;}
  @media (max-width:640px){.field-row-timeline{grid-template-columns:1fr 1fr;}}
  .operador-subheader{
    background:var(--navy);color:#fff;font-family:var(--font-display);text-transform:uppercase;
    letter-spacing:0.05em;font-size:12px;font-weight:700;padding:7px 12px;border-radius:8px 8px 0 0;margin-bottom:0;
  }
  .field-row-timeline-wrap{
    display:flex;gap:14px;align-items:flex-end;background:#fff;border:1px solid #F3E4B8;border-top:none;
    border-radius:0 0 8px 8px;padding:14px;
  }
  .field-row-timeline-wrap .field-row-timeline{flex:1;margin-bottom:0;}
  .hprog-badge{
    background:var(--navy);color:#fff;border-radius:8px;padding:8px 16px;text-align:center;flex-shrink:0;min-width:74px;
  }
  .hprog-label{font-family:var(--font-display);text-transform:uppercase;font-size:9.5px;letter-spacing:0.05em;color:#B9CBDB;}
  .hprog-value{font-family:var(--font-mono);font-size:17px;font-weight:700;color:var(--orange);margin-top:2px;}
  .parada-header{display:flex;gap:8px;font-size:11px;color:var(--text-muted);margin-bottom:5px;padding:0 2px;}
  .parada-header span{flex:1;}
  .parada-header .w90{flex:none;width:90px;}
  .parada-header .w50{flex:none;width:50px;text-align:right;}
  .parada-header .w22{flex:none;width:22px;}

  /* ---------- Consolidation readout ---------- */
  .consol-box{background:#F7FAFC;border:1px solid var(--border);border-radius:8px;padding:10px 12px;margin:10px 0 14px 0;}
  .consol-line{display:flex;justify-content:space-between;font-size:12.5px;padding:3px 0;}
  .consol-line b{font-family:var(--font-mono);}
  .diff-ok{color:var(--st-disp);}
  .diff-warn{color:var(--st-manut);}
  .diff-bad{color:var(--danger);}

  /* ---------- Modal ---------- */
  .modal-overlay{position:fixed;inset:0;background:rgba(15,23,32,0.82);display:none;align-items:center;justify-content:center;padding:20px;z-index:200;overflow-y:auto;}
  .modal-overlay.active{display:flex;}
  .modal{background:#fff;border-radius:12px;max-width:520px;width:100%;max-height:88vh;overflow-y:auto;padding:22px 24px 20px 24px;margin:auto;}
  .modal h3{font-family:var(--font-display);text-transform:uppercase;letter-spacing:0.02em;font-size:17px;margin:0 0 16px 0;color:var(--navy);}
  .modal-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:18px;}
  .form-error{color:var(--danger);font-size:12px;margin-top:-6px;margin-bottom:10px;}

  /* ---------- Toast ---------- */
  .toast-wrap{position:fixed;top:18px;right:18px;z-index:80;display:flex;flex-direction:column;gap:8px;}
  .toast{background:var(--navy-deep);color:#fff;padding:10px 16px;border-radius:8px;font-size:13px;box-shadow:0 6px 18px rgba(0,0,0,0.18);opacity:0;transform:translateY(-6px);max-width:320px;}
  .toast.show{opacity:1;transform:translateY(0);}

  .empty-state{text-align:center;padding:50px 20px;color:var(--text-muted);}
  .empty-state .big{font-family:var(--font-display);text-transform:uppercase;letter-spacing:0.03em;font-size:15px;color:var(--navy);margin-bottom:6px;}

  .rel-header{margin-bottom:16px;}
  .rel-header h1{font-family:var(--font-display);text-transform:uppercase;color:var(--navy);font-size:20px;margin:0;}
  .rel-header .rel-sub{font-size:12.5px;color:var(--text-muted);margin-top:4px;}
  .rel-section{margin-bottom:22px;}
  .rel-section h3{font-family:var(--font-display);text-transform:uppercase;letter-spacing:0.03em;font-size:13px;color:var(--navy);border-bottom:2px solid var(--border);padding-bottom:6px;margin-bottom:10px;}

  @media print{
    body *{ visibility:hidden; }
    #relatorioPreview, #relatorioPreview *{ visibility:visible; }
    #relatorioPreview{ position:absolute; left:0; top:0; width:100%; border:none; padding:0; }
    .view.active, .view.active *{ visibility:visible; }
    .view.active{ position:absolute; left:0; top:0; width:100%; }
    .sidebar, .topbar, .dash-tabbar-row, .dash-filters-panel{ display:none !important; }
    .no-print{ display:none !important; }
  }

  .loading-screen{position:fixed;inset:0;background:var(--bg);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:10px;z-index:100;}
  .loading-screen .spinner{width:34px;height:34px;border-radius:50%;border:3px solid #D8E0E7;border-top-color:var(--blue);animation:spin .8s linear infinite;}
  @keyframes spin{to{transform:rotate(360deg);}}
  .loading-screen .msg{font-size:13px;color:var(--text-muted);}

  .profile-screen{
    position:fixed;inset:0;background:var(--bg);display:flex;align-items:center;justify-content:center;
    flex-direction:column;z-index:110;
  }
  .p-header{
    width:100%;background:linear-gradient(180deg,var(--navy) 0%, var(--navy-deep) 100%);
    padding:34px 20px 24px 20px;text-align:center;
  }
  .p-logo-img{max-width:280px;width:80%;height:auto;margin:0 auto;display:block;}
  .p-header .p-sub-top{color:var(--orange);font-size:13px;letter-spacing:0.14em;text-transform:uppercase;font-weight:700;margin-top:8px;}
  .p-hazard{width:100%;height:14px;background:linear-gradient(90deg, var(--navy-mid), var(--orange));}
  .p-card-wrap{
    flex:1;width:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:30px 20px;
  }
  .p-access-title{font-family:var(--font-display);text-transform:uppercase;letter-spacing:0.03em;font-size:20px;color:var(--navy);font-weight:700;text-align:center;margin-bottom:20px;}
  .login-card{
    background:#fff;border-radius:12px;padding:30px 32px;width:340px;max-width:100%;
    box-shadow:0 1px 4px rgba(16,35,63,0.06);
  }
  .login-card .field label{font-weight:700;color:var(--text);font-size:13px;}
  .login-card input{width:100%;padding:10px 12px;font-size:14px;}
  #loginBtn{padding:11px 14px;font-size:14px;}

  .nav-group-label{
    font-family:var(--font-display);text-transform:uppercase;letter-spacing:0.06em;font-size:10.5px;
    color:#7C93A8;padding:10px 12px 4px 12px;
  }

  @media (max-width:820px){
    #app{flex-direction:column;}
    .sidebar{width:100%;height:auto;position:relative;flex-direction:row;flex-wrap:wrap;align-items:center;padding-bottom:6px;}
    .brand{padding:14px 16px 8px 16px;width:100%;}
    .hazard{width:100%;}
    .nav{display:flex;flex-wrap:wrap;padding:8px 10px;width:100%;}
    .nav-item{width:auto;flex:1 1 auto;justify-content:center;}
    .sidebar-footer{display:none;}
    .view{padding:18px 16px 40px 16px;}
    .topbar{padding:14px 16px;}
  }
</style>
</head>
<body>

